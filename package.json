{
  "name": "msca09aa-website",
  "version": "1.0.0",
  "private": true,
  "description": "Mid-Southern California Area 09 of Alcoholics Anonymous — public website. Built with Eleventy from CSV files and the Area's Google Calendar.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "fetch": "node scripts/fetch-calendar.mjs && node scripts/drive-index.mjs",
    "build:site": "eleventy",
    "build:css": "tailwindcss -i src/assets/css/site.css -o _site/assets/css/site.css --minify",
    "build:search": "pagefind --site _site",
    "build": "npm run build:site && npm run build:css && npm run build:search",
    "build:fresh": "npm run fetch && npm run build",
    "check": "node scripts/check-site.mjs",
    "check:media": "node scripts/check-media.mjs",
    "dev:site": "eleventy --serve --quiet",
    "dev:css": "tailwindcss -i src/assets/css/site.css -o _site/assets/css/site.css --watch",
    "start": "run-p dev:site dev:css",
    "clean": "node -e \"require('fs').rmSync('_site',{recursive:true,force:true})\"",
    "check:calendar": "node scripts/check-calendar.mjs",
    "drive:ids": "python scripts/drive_ids.py",
    "social-card": "python scripts/build-social-card.py"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-img": "^7.0.0",
    "@alpinejs/collapse": "^3.17.4",
    "@alpinejs/focus": "^3.17.4",
    "@alpinejs/intersect": "^3.17.4",
    "@alpinejs/persist": "^3.17.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "alpinejs": "^3.17.4",
    "csv-parse": "^7.0.3",
    "fullcalendar": "6.1.21",
    "fuse.js": "^7.5.0",
    "ical.js": "^2.2.1",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-static": "^1.52.0",
    "luxon": "^3.7.2",
    "markdown-it": "^15.0.2",
    "npm-run-all2": "^7.0.2",
    "pagefind": "^1.5.2",
    "photoswipe": "^5.4.4",
    "swiper": "^14.3.0",
    "tailwindcss": "^4.3.3"
  }
}
