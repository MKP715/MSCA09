---
pagination: { data: langs, size: 1, alias: lang, addAllPagesToCollections: true }
permalink: "{{ lang.prefix }}/service/motions/"
layout: page.njk
title_key: service.motions.title
description_key: service.motions.description
eyebrow_key: service.motions.eyebrow
lead_key: service.motions.lead
heroIcon: gavel
accent: sun
crumbs: [{ label_key: "service.title", url: "/service/" }]
bare: true
scripts: ["/assets/js/service.js"]
---
{%- from "macros/ui.njk" import sectionHead with context -%}
{%- from "macros/service.njk" import motionCard, docRows with context -%}
{%- set L = lang -%}
{%- set list = motions.list or [] -%}
{%- set statuses = motions.statuses or [] -%}
{%- set openList = motions.open or [] -%}
{%- set curPanel = motions.currentPanel or site.panel -%}
{%- set agendaRow = openList | svcFirstMatch("agenda_url_en", ".") -%}
{%- set howDoc = (documents.all or []) | svcFirstMatch("title", "making a motion") if documents else null -%}
{%- set books = ((documents.byCategory.motions if (documents and documents.byCategory) else []) or []) | svcMatch("title", "^motions") -%}
{%- set secretary = site.email_secretary or "secretary@msca09aa.org" -%}

<div class="wrap space-y-20 py-12 lg:space-y-24 lg:py-16 2xl:py-20">

  {#- ============================================================ status overview -#}
  <section aria-labelledby="now-title" class="grid grid-cols-1 items-start gap-6 xl:grid-cols-12 xl:gap-8">
    <div class="relative isolate overflow-hidden rounded-[2rem] p-6 text-ink-950 shadow-lift sm:p-8 xl:col-span-5 2xl:p-10" style="{{ 'sun' | accent }}">
      <div class="absolute inset-0 -z-10" aria-hidden="true" style="background: radial-gradient(30rem 20rem at 100% 0%, var(--color-coral-200), transparent 60%), linear-gradient(140deg, var(--color-sun-200), var(--color-sun-100) 50%, var(--color-copper-100));"></div>
      <p class="eyebrow text-(--a-800)">{% icon "messages-square", "size-4" %}{{ "service.motions.now_eyebrow" | t(L, { panel: curPanel }) }}</p>
      {%- set nowKey = "service.motions.now_title_none" if openList.length == 0 else ("service.motions.now_title_one" if openList.length == 1 else "service.motions.now_title") %}
      <h2 id="now-title" class="mt-2 font-display text-3xl font-extrabold text-balance sm:text-4xl">{{ nowKey | t(L, { n: openList.length }) }}</h2>
      <p class="mt-3 text-[17px] leading-relaxed text-ink-700">{{ "service.motions.now_body" | t(L) }}</p>
      <ul class="mt-6 space-y-2" role="list">
        {%- for m in openList | limit(4) %}
        <li><a href="#motion-{{ m.id | slugify }}" class="flex min-h-11 items-center gap-3 rounded-2xl bg-white/80 px-4 py-3 shadow-sm ring-1 ring-ink-900/5 backdrop-blur transition hover:bg-white"><span class="svc-motion__id">{{ (m | loc("label", L)) or m.id }}</span><span class="min-w-0 flex-1 truncate font-semibold">{{ m | loc("title", L) }}</span>{% icon "arrow-down", "size-4 shrink-0 text-ink-400" %}</a></li>
        {%- endfor %}
      </ul>
      {%- if openList.length > 4 %}
      <p class="mt-2 px-1 text-sm font-semibold text-ink-600">{{ "service.motions.now_more" | t(L, { n: openList.length - 4 }) }}</p>
      {%- endif %}
      {%- if agendaRow %}
      <a href="{{ agendaRow | loc('agenda_url', L) }}" target="_blank" rel="noopener" class="btn btn-primary mt-6 max-w-full whitespace-normal text-left">{% icon "list-ordered", "size-4 shrink-0" %}{{ "service.motions.latest_agenda" | t(L) }}</a>
      {%- endif %}
    </div>

    {#- status tiles: each one filters the board below (all panels) and scrolls to it -#}
    <div class="xl:col-span-7">
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 xl:gap-4" x-data role="group" aria-label="{{ 'service.motions.tiles_label' | t(L) }}">
      {%- for st in statuses %}{% if not st.archive %}
      <button type="button" class="svc-tile card card-hover group" style="{{ st.color | accent }}"
              @click="$dispatch('svc-motions', { status: '{{ st.key }}', panel: 'all' })">
        <span class="flex items-center justify-between gap-2"><span class="icon-tile size-11 rounded-xl">{% icon st.icon, "size-5" %}</span><span class="font-display text-4xl font-extrabold text-ink-950 2xl:text-5xl">{{ motions.counts[st.key] }}</span></span>
        <span class="flex items-center justify-between gap-2 font-semibold text-ink-700 group-hover:text-(--a-700)">{{ ("service.motions.status_" + st.key) | t(L) }}{% icon "arrow-down", "size-4 shrink-0 text-ink-300 transition group-hover:translate-y-0.5 group-hover:text-(--a-600)" %}</span>
      </button>
      {%- endif %}{% endfor %}
      {%- for st in statuses %}{% if st.archive and motions.counts[st.key] %}
      <button type="button" class="svc-tile svc-tile--wide card card-hover group col-span-full" style="{{ st.color | accent }}"
              @click="$dispatch('svc-motions', { status: '{{ st.key }}', panel: 'all' })">
        <span class="icon-tile size-11 shrink-0 rounded-xl">{% icon st.icon, "size-5" %}</span>
        <span class="min-w-0 flex-1 text-left">
          <span class="block font-semibold text-ink-800 group-hover:text-(--a-700)">{{ ("service.motions.status_" + st.key) | t(L) }}</span>
          <span class="block text-sm leading-snug text-ink-500">{{ "service.motions.col_unrecorded_short" | t(L) }}</span>
        </span>
        <span class="font-display text-3xl font-extrabold text-ink-700">{{ motions.counts[st.key] }}</span>
      </button>
      {%- endif %}{% endfor %}
    </div>
    <p class="mt-4 flex items-start gap-2 px-1 text-sm leading-relaxed text-ink-500">{% icon "mouse-pointer-click", "mt-0.5 size-4 shrink-0 text-sun-700" %}<span>{{ "service.motions.tiles_hint" | t(L) }} <a href="mailto:{{ secretary }}?subject={{ 'service.motions.ask_subject' | t(L) | urlencode }}" class="font-semibold text-ink-700 underline decoration-ink-300 underline-offset-2 hover:decoration-ink-600">{{ "service.motions.ask_secretary" | t(L) }}</a></span></p>
    </div>
  </section>

  {#- ============================================================ the board -#}
  <section id="board" aria-labelledby="board-title" class="scroll-mt-28" x-data="svcMotions(5, '{{ curPanel }}')" @svc-motions.window="filter($event.detail)">
    {{ sectionHead({ eyebrow: "service.motions.board_eyebrow" | t(L), title: "service.motions.board_title" | t(L), lead: "service.motions.board_lead" | t(L, { panel: curPanel }), id: "board-title", accent: "ocean" }) }}
    <div class="mb-4 flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
      <div class="no-scrollbar -mx-4 flex gap-2 overflow-x-auto px-4 pb-1 sm:mx-0 sm:flex-wrap sm:px-0" role="group" aria-label="{{ 'service.motions.panel' | t(L) }}">
        {%- for p in motions.panels %}
        <button type="button" class="svc-chip" style="{{ ('coral' if p == curPanel else 'ocean') | accent }}" aria-pressed="{{ 'true' if p == curPanel else 'false' }}" :aria-pressed="(panel === '{{ p }}').toString()" @click="panel = '{{ p }}'">{{ "service.posts.panel_n" | t(L, { n: p }) }}<span class="svc-chip__n">{{ list | svcCount("panel", p) }}</span></button>
        {%- endfor %}
        <button type="button" class="svc-chip" style="{{ 'iris' | accent }}" aria-pressed="false" :aria-pressed="(panel === 'all').toString()" @click="panel = 'all'">{% icon "layers", "size-4" %}{{ "service.motions.all_panels" | t(L) }}<span class="svc-chip__n">{{ list.length }}</span></button>
      </div>
      <label class="relative block w-full lg:max-w-sm">
        <span class="sr-only">{{ "service.motions.search" | t(L) }}</span>
        {% icon "search", "pointer-events-none absolute top-1/2 left-4 size-5 -translate-y-1/2 text-ink-400" %}
        <input type="search" x-model.debounce.150ms="q" class="field pl-12" placeholder="{{ 'service.motions.search' | t(L) }}" autocomplete="off">
      </label>
    </div>
    {#- status chips (their numbers follow the panel and the search) -#}
    <div class="no-scrollbar -mx-4 mb-6 flex gap-2 overflow-x-auto px-4 pb-1 sm:mx-0 sm:flex-wrap sm:px-0" role="group" aria-label="{{ 'service.motions.status' | t(L) }}">
      <button type="button" class="svc-chip" style="{{ 'iris' | accent }}" aria-pressed="true" :aria-pressed="(status === 'all').toString()" @click="status = 'all'">{{ "ui.all" | t(L) }}<span class="svc-chip__n" x-text="shown">{{ list | svcCount("panel", curPanel) }}</span></button>
      {%- for st in statuses %}{% if motions.counts[st.key] %}
      <button type="button" class="svc-chip" style="{{ st.color | accent }}" aria-pressed="false" :aria-pressed="(status === '{{ st.key }}').toString()" @click="status = '{{ st.key }}'"
              {% if not motions.currentCounts[st.key] %}hidden{% endif %} x-bind:hidden="!(counts['{{ st.key }}'] > 0 || status === '{{ st.key }}')">{% icon st.icon, "size-4" %}{{ ("service.motions.status_" + st.key) | t(L) }}<span class="svc-chip__n" x-text="counts['{{ st.key }}'] || 0">{{ motions.currentCounts[st.key] }}</span></button>
      {%- endif %}{% endfor %}
    </div>

    <div class="svc-board" :class="status !== 'all' && 'is-single'">
      {%- for st in statuses %}{% if motions.counts[st.key] %}
      <section class="svc-col{{ ' svc-col--archive' if st.archive }}" style="{{ st.color | accent }}" data-col="{{ st.key }}" {% if st.archive %}data-cap="0"{% endif %} aria-labelledby="col-{{ st.key }}"
               {% if not motions.currentCounts[st.key] %}hidden{% endif %}>
        <header class="svc-col__head">
          <h3 id="col-{{ st.key }}" class="svc-col__title"><span class="icon-tile">{% icon st.icon, "size-[18px]" %}</span>{{ ("service.motions.status_" + st.key) | t(L) }}</h3>
          <span class="svc-col__count" x-text="counts['{{ st.key }}']">{{ motions.currentCounts[st.key] }}</span>
        </header>
        {%- if st.archive %}
        <p class="px-1 text-sm leading-snug text-ink-600">{{ "service.motions.col_unrecorded" | t(L) }} <a href="mailto:{{ secretary }}?subject={{ 'service.motions.ask_subject' | t(L) | urlencode }}" class="font-semibold text-ink-800 underline decoration-ink-300 underline-offset-2 hover:decoration-ink-600">{{ "service.motions.ask_secretary" | t(L) }}</a></p>
        {%- else %}
        <p class="px-1 text-sm leading-snug text-ink-600">{{ ("service.motions.col_" + st.key) | t(L) }}</p>
        {%- endif %}
        {%- for m in motions.byStatus[st.key] %}
        {{ motionCard({ m: m, lang: L }) }}
        {%- endfor %}
        <button type="button" x-cloak x-show="extra['{{ st.key }}'] > 0" @click="more('{{ st.key }}')" class="btn btn-white w-full">
          {% icon "chevrons-down", "size-4 text-(--a-600)" %}<span data-tpl="{{ ('service.motions.show_archived' if st.archive else 'service.motions.show_more') | t(L) }}" x-text="$el.dataset.tpl.replace('{n}', extra['{{ st.key }}'])"></span>
        </button>
      </section>
      {%- endif %}{% endfor %}
    </div>
    <div x-cloak x-show="total === 0" class="card mt-4 flex flex-col items-center gap-3 p-10 text-center">
      <p class="font-semibold text-ink-800">{{ "ui.no_results" | t(L) }}</p>
      <button type="button" class="btn btn-ghost btn-sm" @click="reset()">{{ "ui.clear" | t(L) }}</button>
    </div>
    <p class="mt-5 flex items-start gap-2 text-sm text-ink-500">{% icon "info", "mt-0.5 size-4 shrink-0" %}<span>{{ "service.motions.board_note" | t(L) }}</span></p>
  </section>

  {#- ============================================================ how a motion works -#}
  <section aria-labelledby="how-title">
    {{ sectionHead({ eyebrow: "service.motions.how_eyebrow" | t(L), title: "service.motions.how_title" | t(L), lead: "service.motions.how_lead" | t(L), id: "how-title", accent: "iris" }) }}
    {%- set steps = [["write", "pen-line", "sun"], ["new", "sparkles", "ocean"], ["groups", "users", "sage"], ["vote", "vote", "iris"], ["minority", "scale", "coral"], ["record", "book-marked", "sea"]] -%}
    <ol class="relative grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 2xl:grid-cols-6" role="list">
      {%- for s in steps %}
      <li class="svc-ballot reveal flex-col" style="{{ s[2] | accent }}; --reveal-delay: {{ loop.index0 * 70 }}ms">
        <div class="flex items-center gap-3">
          <span class="svc-ballot__n">{{ loop.index }}</span>
          <span class="icon-tile-soft size-10 rounded-xl">{% icon s[1], "size-5" %}</span>
        </div>
        <h3 class="mt-2 font-display text-lg font-bold text-ink-950">{{ ("service.motions.how_" + s[0]) | t(L) }}</h3>
        <p class="text-[15px] leading-relaxed text-ink-600">{{ ("service.motions.how_" + s[0] + "_body") | t(L) }}</p>
      </li>
      {%- endfor %}
    </ol>

    <div class="mt-8 grid grid-cols-1 gap-6 lg:grid-cols-12">
      <div class="card-accent p-6 sm:p-8 lg:col-span-7" style="{{ 'sun' | accent }}">
        <h3 class="flex items-center gap-3 font-display text-xl font-bold text-ink-950"><span class="icon-tile size-11 rounded-xl">{% icon "file-pen-line", "size-5" %}</span>{{ "service.motions.write_title" | t(L) }}</h3>
        <ul class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-2" role="list">
          {%- for i in [1, 2, 3, 4, 5, 6] %}
          <li class="flex gap-2.5 text-[15px] leading-relaxed text-ink-700">{% icon "check", "mt-1 size-4 shrink-0 text-sun-700" %}<span>{{ ("service.motions.write_" + i) | t(L) }}</span></li>
          {%- endfor %}
        </ul>
        <div class="mt-6 flex flex-wrap gap-2.5">
          {%- if howDoc %}<a href="{{ howDoc.url }}" target="_blank" rel="noopener" class="btn btn-accent" style="{{ 'copper' | accent }}">{% icon "file-text", "size-4" %}{{ "service.motions.gap_doc" | t(L) }}</a>{% endif %}
          <a href="mailto:gapchair@msca09aa.org" class="btn btn-ghost">{% icon "mail", "size-4" %}{{ "service.motions.gap_contact" | t(L) }}</a>
          <a href="mailto:{{ secretary }}" class="btn btn-ghost">{% icon "mail", "size-4" %}{{ "service.motions.secretary_contact" | t(L) }}</a>
        </div>
      </div>
      <div class="card p-6 sm:p-8 lg:col-span-5" style="{{ 'sea' | accent }}">
        <h3 class="flex items-center gap-3 font-display text-xl font-bold text-ink-950"><span class="icon-tile size-11 rounded-xl">{% icon "library-big", "size-5" %}</span>{{ "service.motions.books_title" | t(L) }}</h3>
        <p class="mt-3 text-[15px] leading-relaxed text-ink-600">{{ "service.motions.books_body" | t(L) }}</p>
        <div class="mt-3">{{ docRows({ docs: books | sortBy("date", "desc"), lang: L, limit: 6, empty: "service.motions.books_empty" | t(L) }) }}</div>
        <a href="{{ '/documents/motions/' | lurl(L) }}" class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-sea-700 hover:underline">{{ "service.motions.books_all" | t(L) }}{% icon "arrow-right", "size-4" %}</a>
        <a href="{{ 'service.motions.books_archives.url' | t(L) }}" target="_blank" rel="noopener" class="mt-2 flex items-center gap-1.5 text-sm font-semibold text-sea-700 hover:underline">{{ "service.motions.books_archives" | t(L) }}{% icon "external-link", "size-4" %}</a>
      </div>
    </div>
  </section>
</div>
