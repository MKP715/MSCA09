---
pagination:
  data: langs
  size: 1
  alias: lang
  addAllPagesToCollections: true
permalink: "{{ lang.prefix }}/events/"
layout: page.njk
title_key: calendar.events.title
description_key: calendar.events.description
eyebrow_key: calendar.events.eyebrow
lead_key: calendar.events.lead
heroIcon: list
accent: sea
bare: true
crumbs: [{ label_key: "nav.calendar", url: "/calendar/" }]
---
{%- from "macros/events.njk" import upcomingList, dateBadge -%}
{%- from "macros/ui.njk" import sectionHead, formatBadge, langBadge -%}
{%- set L = lang -%}
{%- set C = calendar -%}

{%- macro seriesCard(s, L) -%}
<a href="{{ s.url | lurl(L) }}" class="series-card group" style="{{ s.color | accent }}">
  <span class="flex items-start justify-between gap-3">
    <span class="min-w-0">
      <span class="series-card__title">{{ s | calTitle(L) }}</span>
      <span class="series-card__rule">{% icon "repeat", "size-3.5 shrink-0" %}{{ s | calLoc("rule", L) }}</span>
    </span>
    <span class="icon-tile-soft size-10 shrink-0 transition group-hover:scale-110">{% icon s.icon, "size-5" %}</span>
  </span>
  <span class="series-card__meta">{% icon "clock", "size-3.5 shrink-0" %}{{ s | calLoc("timeLabel", L) }}</span>
  <span class="series-card__meta">{% if s.location and s.location.city %}{% icon "map-pin", "size-3.5 shrink-0" %}{{ s.location.city }}{% if s.online %} · + Zoom{% endif %}{% elif s.format == "Virtual" %}{% icon "video", "size-3.5 shrink-0" %}{{ "format.virtual" | t(L) }} · Zoom{% elif s.online %}{% icon "video", "size-3.5 shrink-0" %}Zoom · {{ "calendar.place_varies" | t(L) }}{% else %}{% icon "map-pin", "size-3.5 shrink-0" %}{{ "calendar.place_tba" | t(L) }}{% endif %}</span>
  <span class="mt-auto flex flex-wrap items-center gap-1.5 pt-3">
    {{ formatBadge({ format: s.format, lang: L }) }}{% if s.language != "English" %}{{ langBadge({ language: s.language, lang: L }) }}{% endif %}
    {%- set nx = (s.upcomingDates or []) | where("status", "confirmed") | limit(3) %}
    {%- if nx.length %}
    <span class="ml-auto" data-limit="1">{% for n in nx %}<span class="text-xs font-semibold text-ink-500" data-hide-after="{{ n.end }}" data-when="{{ n.start }}" data-until="{{ n.end }}"><span data-rel hidden class="rel-badge"></span></span>{% endfor %}</span>
    {%- endif %}
  </span>
</a>
{%- endmacro -%}

{#- ---- jump links: one compact row that stays under the header on phones and tablets -#}
<div class="ev-jump-bar">
  <div class="wrap">
  <nav class="ev-jump no-scrollbar" aria-label="{{ 'calendar.events.jump' | t(L) }}">
    <a href="#meetings" class="cal-quick__btn" style="{{ 'sea' | accent }}">{% icon "repeat", "size-4" %}{{ "calendar.events.meetings" | t(L) }}</a>
    <a href="#upcoming" class="cal-quick__btn" style="{{ 'coral' | accent }}">{% icon "sparkles", "size-4" %}{{ "calendar.events.upcoming" | t(L) }}</a>
    <a href="#archive" class="cal-quick__btn" style="{{ 'copper' | accent }}">{% icon "history", "size-4" %}{{ "calendar.events.archive" | t(L) }}</a>
    <a href="{{ '/calendar/' | lurl(L) }}" class="cal-quick__btn" style="{{ 'iris' | accent }}">{% icon "calendar-days", "size-4" %}{{ "calendar.open_calendar" | t(L) }}</a>
  </nav>
  </div>
</div>

{#- ---- regular meetings by type -#}
<section id="meetings" class="wrap scroll-mt-28 py-14 lg:py-20" aria-labelledby="meetings-title">
  {{ sectionHead({ eyebrow: "calendar.events.meetings_eyebrow" | t(L), title: "calendar.events.meetings" | t(L), lead: "calendar.events.meetings_lead" | t(L, { n: C.stats.series }), id: "meetings-title" }) }}
  <div class="space-y-12">
    {%- for g in C.directory %}
    <div class="reveal" style="{{ g.type.color | accent }}">
      <h3 class="mb-5 flex flex-wrap items-center gap-3 font-display text-2xl font-bold text-ink-950">
        <span class="icon-tile size-10">{% icon g.type.icon, "size-5" %}</span>{{ g.type | loc("label", L) }}
        <span class="chip chip-accent">{{ g.items.length }}</span>
      </h3>
      {%- if g.type | loc("description", L) %}<p class="-mt-2 mb-5 max-w-3xl text-ink-600">{{ g.type | loc("description", L) }}</p>{% endif %}
      <ul class="rail sm:mx-0 sm:grid sm:grid-cols-2 sm:gap-4 sm:overflow-visible sm:px-0 sm:pb-0 lg:grid-cols-3 2xl:grid-cols-4 3xl:grid-cols-5" role="list">
        {%- for s in g.items %}<li class="w-[82%] min-w-0 shrink-0 sm:w-auto">{{ seriesCard(s, L) }}</li>{% endfor %}
      </ul>
    </div>
    {%- endfor %}
  </div>
</section>

{#- ---- upcoming one-time events -#}
<section id="upcoming" class="relative isolate scroll-mt-28 overflow-hidden py-14 lg:py-20" aria-labelledby="upcoming-title">
  <div class="absolute inset-0 -z-10 bg-ring-soft" aria-hidden="true"></div>
  <div class="wrap">
    {{ sectionHead({ eyebrow: "calendar.featured.eyebrow" | t(L), title: "calendar.events.upcoming" | t(L), lead: "calendar.featured.lead" | t(L), id: "upcoming-title" }) }}
    {{ upcomingList({ items: C.featuredEvents, lang: L, limit: 15, variant: "flyer", id: "events-upcoming" }) }}
  </div>
</section>

{#- ---- past events, by year -#}
<section id="archive" class="wrap scroll-mt-28 py-14 lg:py-20" aria-labelledby="archive-title">
  {{ sectionHead({ eyebrow: "calendar.events.archive_eyebrow" | t(L), title: "calendar.events.archive" | t(L), lead: "calendar.events.archive_lead" | t(L, { n: C.stats.pastEvents }), id: "archive-title" }) }}
  <div class="space-y-4">
    {%- for y in C.archive %}
    <details id="y{{ y.year }}" class="archive-year group scroll-mt-28" {% if loop.first %}open{% endif %}>
      <summary class="archive-year__head">
        <span class="font-display text-3xl font-extrabold text-ink-950">{{ y.year }}</span>
        <span class="text-base font-semibold text-ink-500">{{ "calendar.events.n_events" | t(L, { n: y.items.length }) }}</span>
        <span class="archive-year__thumbs" aria-hidden="true">
          {%- for s in (y.items | where("hasFlyer") | limit(5)) %}<img src="{{ s.flyers[0].id | driveImg(120) }}" alt="" loading="lazy" decoding="async" onerror="this.remove()">{% endfor %}
        </span>
        <span class="archive-year__chev">{% icon "chevron-down", "size-5" %}</span>
      </summary>
      <ul class="mt-5 grid gap-3 sm:grid-cols-2 xl:grid-cols-3 3xl:grid-cols-4" role="list">
        {%- for s in y.items %}
        <li class="min-w-0">
          <a href="{{ s.url | lurl(L) }}" class="past-row group" style="{{ s.color | accent }}">
            {{ dateBadge({ iso: s.start, lang: L, color: s.color, size: "sm" }) }}
            <span class="min-w-0 flex-1">
              <span class="past-row__title">{{ s | calTitle(L) }}</span>
              <span class="past-row__meta"><span class="ev-type ev-type--sm">{{ s | calTypeLabel(L) }}</span>{% if s.location and s.location.city %}<span class="truncate">{{ s.location.city }}</span>{% elif s.format == "Virtual" %}<span>{{ "format.virtual" | t(L) }}</span>{% endif %}</span>
            </span>
            {%- if s.flyers.length %}<img src="{{ s.flyers[0].id | driveImg(160) }}" alt="" aria-hidden="true" class="past-row__thumb" loading="lazy" decoding="async" onerror="this.remove()">{% endif %}
          </a>
        </li>
        {%- endfor %}
      </ul>
    </details>
    {%- endfor %}
  </div>
</section>
