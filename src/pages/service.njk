---
pagination: { data: langs, size: 1, alias: lang, addAllPagesToCollections: true }
permalink: "{{ lang.prefix }}/service/"
layout: page.njk
title_key: service.title
description_key: service.description
eyebrow_key: service.eyebrow
lead_key: service.lead
heroIcon: landmark
accent: iris
crumbs: []
bare: true
scripts: ["/assets/js/service.js"]
---
{%- from "macros/ui.njk" import sectionHead, emailLink with context -%}
{%- from "macros/service.njk" import kindChip, districtLinks, nextMeeting, meetingTimeline, docRows, motionRows, svcStat with context -%}
{%- set L = lang -%}
{%- set years = site.panel_years | svcYears -%}
{%- set thisYear = site.build.year -%}
{%- set areaAll = (calendar.areaMeetings or []) | svcDedupe -%}
{%- set next = calendar.nextAreaMeeting -%}
{%- set openMotions = (motions.open or []) -%}

<div class="wrap space-y-20 py-12 lg:space-y-24 lg:py-16 2xl:py-20">

  {#- ============================================================ next meeting + quick links -#}
  <section class="grid grid-cols-1 gap-8 xl:grid-cols-12 xl:gap-10" aria-labelledby="next-title">
    <div class="xl:col-span-8 2xl:col-span-8">
      <h2 id="next-title" class="sr-only">{{ "service.next.eyebrow" | t(L) }}</h2>
      {%- if next %}
      <div id="next-wrap" data-empty="#next-none">
        {{ nextMeeting({ occ: next, calendar: calendar, lang: L }) }}
      </div>
      {%- endif %}
      <div id="next-none" class="card flex flex-col items-start gap-4 p-8 lg:p-10" style="{{ 'iris' | accent }}" {% if next %}hidden{% endif %}>
        <span class="icon-tile">{% icon "calendar-clock", "size-6" %}</span>
        <h3 class="font-display text-2xl font-bold text-ink-950">{{ "service.next.none_title" | t(L) }}</h3>
        <p class="max-w-2xl text-ink-600">{{ "service.next.none_body" | t(L) }}</p>
        <a href="{{ '/calendar/' | lurl(L) }}" class="btn btn-ocean">{% icon "calendar-days", "size-4" %}{{ "service.next.open_calendar" | t(L) }}</a>
      </div>
      <p class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-ink-600">
        <a href="{{ '/service/area-meetings/' | lurl(L) }}" class="inline-flex items-center gap-1.5 font-semibold text-iris-700 hover:underline">{% icon "calendar-range", "size-4" %}{{ "service.next.all" | t(L) }}</a>
        <a href="{{ '/service/area-meetings/#asc-vs-asa' | lurl(L) }}" class="inline-flex items-center gap-1.5 font-semibold text-iris-700 hover:underline">{% icon "circle-help", "size-4" %}{{ "service.next.whats" | t(L) }}</a>
      </p>
    </div>

    <aside class="xl:col-span-4" aria-labelledby="quick-title">
      <div class="card h-full p-5 sm:p-6 2xl:p-7">
        <h2 id="quick-title" class="eyebrow mb-4" style="{{ 'iris' | accent }}">{% icon "compass", "size-4" %}{{ "service.quick.title" | t(L) }}</h2>
        {%- set quick = [
          { url: "/service/motions/", icon: "gavel", color: "sun", key: "motions", meta: ("service.quick.motions_meta" | t(L, { n: openMotions.length })) if openMotions.length else "" },
          { url: "/documents/", icon: "file-text", color: "sea", key: "minutes", meta: "" },
          { url: "/service/delegate/", icon: "mic", color: "coral", key: "delegate", meta: "" },
          { url: "/service/area-meetings/", icon: "calendar-range", color: "ocean", key: "meetings", meta: "" },
          { url: "/committees/", icon: "users", color: "sage", key: "committees", meta: "" },
          { url: "/about/panel/", icon: "contact", color: "lilac", key: "panel", meta: "" },
          { url: "/about/structure/", icon: "triangle", color: "blush", key: "structure", meta: "" }
        ] %}
        <ul class="grid grid-cols-1 gap-1.5 sm:grid-cols-2 xl:grid-cols-1" role="list">
          {%- for q in quick %}
          <li style="{{ q.color | accent }}">
            <a href="{{ q.url | lurl(L) }}" class="group flex items-center gap-3 rounded-2xl p-2.5 transition hover:bg-(--a-50)">
              <span class="icon-tile size-11 rounded-xl transition group-hover:scale-110 group-hover:rotate-[-4deg]">{% icon q.icon, "size-5" %}</span>
              <span class="min-w-0 flex-1">
                <span class="block font-semibold text-ink-900">{{ ("service.quick." + q.key) | t(L, { panel: site.panel }) }}</span>
                <span class="block truncate text-sm text-ink-500">{{ q.meta or (("service.quick." + q.key + "_desc") | t(L)) }}</span>
              </span>
              {% icon "chevron-right", "size-4 shrink-0 text-ink-300 transition group-hover:translate-x-0.5 group-hover:text-(--a-600)" %}
            </a>
          </li>
          {%- endfor %}
        </ul>
      </div>
    </aside>
  </section>

  {#- ============================================================ panel timeline -#}
  {%- set tlYears = years | svcYearsWith(areaAll) -%}
  {%- if tlYears.length %}
  {%- set firstTab = thisYear if (thisYear in tlYears) else tlYears[0] -%}
  {%- set isTabs = tlYears.length > 1 -%}
  {#- year tabs: a URL hash selects a year only when it names one (#y2027); any other hash (#new-gsr, #learn-title …) keeps the default -#}
  <section aria-labelledby="tl-title" x-data="svcYearTabs('y{{ firstTab }}', [{% for y in tlYears %}'y{{ y }}'{% if not loop.last %}, {% endif %}{% endfor %}])">
    {{ sectionHead({ eyebrow: "service.timeline.eyebrow" | t(L, { panel: site.panel }), title: "service.timeline.title" | t(L), lead: "service.timeline.lead" | t(L), id: "tl-title", accent: "ocean" }) }}
    <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
      {%- if isTabs %}
      <div class="inline-flex rounded-full bg-ink-100 p-1" role="tablist" aria-label="{{ 'service.timeline.years' | t(L) }}" @keydown="key($event)">
        {%- for y in tlYears %}
        <button type="button" role="tab" id="tab-y{{ y }}" data-tab="y{{ y }}" aria-controls="panel-y{{ y }}"
                class="min-h-11 rounded-full px-5 py-2 text-sm font-bold transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ocean-600"
                :class="tab === 'y{{ y }}' ? 'bg-white text-ink-950 shadow-soft' : 'text-ink-600 hover:text-ink-900'"
                aria-selected="{{ 'true' if y == firstTab else 'false' }}" tabindex="{{ '0' if y == firstTab else '-1' }}"
                :aria-selected="(tab === 'y{{ y }}').toString()" :tabindex="tab === 'y{{ y }}' ? 0 : -1" @click="go('y{{ y }}')">{{ y }}</button>
        {%- endfor %}
      </div>
      {%- endif %}
      <ul class="flex flex-wrap gap-1.5" aria-label="{{ 'service.timeline.legend' | t(L) }}">
        {%- for k in ["asa", "asc", "preconf", "shareback", "foro", "servathon"] %}<li>{{ kindChip({ kind: k, lang: L }) }}</li>{% endfor %}
      </ul>
    </div>
    {%- for y in tlYears %}
    {%- set yItems = (areaAll | svcInYears([y])) | svcMatch("type", "^(?!Conference$)") -%}
    <div x-show="tab === 'y{{ y }}'" {% if y != firstTab %}x-cloak{% endif %}
         {% if isTabs %}role="tabpanel" id="panel-y{{ y }}" aria-labelledby="tab-y{{ y }}" tabindex="0"{% endif %} class="rounded-3xl focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ocean-500">
      {{ meetingTimeline({ items: yItems, calendar: calendar, lang: L, next: next }) }}
      {%- if (yItems | svcCount("type", "Area")) == yItems.length %}
      <p class="mt-4 flex items-center gap-2 text-sm text-ink-500">{% icon "info", "size-4" %}{{ "service.timeline.placeholder_note" | t(L, { year: y }) }}</p>
      {%- endif %}
    </div>
    {%- endfor %}
  </section>
  {%- endif %}

  {#- ============================================================ what the Area does -#}
  {%- set dEn = (districts.english or []) | length -%}
  {%- set dEs = (districts.spanish or []) | length -%}
  {%- set dAll = (districts.list or []) | length -%}
  {#- the same count as the Committees page and the home page: standing committees, with the two service schools named beside them -#}
  {%- set standing = (committees.list or []) | svcMatch("category", "^standing$") | length -%}
  {%- set schools = (committees.list or []) | svcMatch("category", "^school$") | length -%}
  <section aria-labelledby="does-title">
    {{ sectionHead({ eyebrow: "service.does.eyebrow" | t(L), title: "service.does.title" | t(L), lead: "service.does.lead" | t(L), id: "does-title", accent: "coral" }) }}
    {#- phones: a swipeable rail — focusable so it can be scrolled with the arrow keys -#}
    <div class="rail svc-rail sm:mx-0 sm:grid sm:grid-cols-2 sm:gap-5 sm:overflow-visible sm:px-0 sm:pb-0 xl:grid-cols-4 2xl:gap-6" tabindex="0" role="region" aria-label="{{ 'service.does.rail' | t(L) }}">
      {%- for c in [["voice", "megaphone", "coral"], ["elect", "vote", "iris"], ["serve", "hand-heart", "sage"], ["learn", "graduation-cap", "sun"]] %}
      <article class="card-accent reveal w-[82%] shrink-0 p-6 sm:w-auto 2xl:p-7" style="{{ c[2] | accent }}; --reveal-delay: {{ loop.index0 * 90 }}ms">
        <span class="icon-tile">{% icon c[1], "size-6" %}</span>
        <h3 class="mt-4 font-display text-xl font-bold text-ink-950">{{ ("service.does." + c[0] + "_title") | t(L) }}</h3>
        <p class="mt-2 leading-relaxed text-ink-600">{{ ("service.does." + c[0] + "_body") | t(L, { districts: dAll or 22, committees: standing or 17, schools: schools or 2 }) }}</p>
      </article>
      {%- endfor %}
    </div>
    <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4 2xl:gap-6">
      {{ svcStat({ value: dAll or 22, label: ("service.stat.districts" | t(L, { en: dEn or 16, es: dEs or 6 })), icon: "map", color: "copper" }) }}
      {{ svcStat({ value: standing or 17, label: "service.stat.committees" | t(L), sub: ("service.stat.schools" | t(L, { n: schools or 2 })), icon: "users", color: "sage" }) }}
      {{ svcStat({ value: 12, label: "service.stat.meetings" | t(L), icon: "calendar-range", color: "ocean" }) }}
      {{ svcStat({ value: 93, label: "service.stat.areas" | t(L), icon: "globe", color: "iris" }) }}
    </div>
  </section>

  {#- ============================================================ new GSR -#}
  {% include "partials/service-gsr.njk" %}

  {#- ============================================================ service learning & events -#}
  <section aria-labelledby="learn-title">
    {{ sectionHead({ eyebrow: "service.learn.eyebrow" | t(L), title: "service.learn.title" | t(L), lead: "service.learn.lead" | t(L), id: "learn-title", accent: "sage" }) }}
    {%- set study = calendar.bySlug["service-study"] if calendar.bySlug else null -%}
    {%- set sharing = calendar.bySlug["sharing-session"] if calendar.bySlug else null -%}
    {%- set gsrs = calendar.bySlug["gsr-school"] if calendar.bySlug else null -%}
    <div class="grid grid-cols-1 gap-6 xl:grid-cols-12">
      {#- Monthly Service Study: the hero card -#}
      <article class="svc-study relative isolate overflow-hidden rounded-[2rem] p-6 text-white shadow-lift sm:p-8 xl:col-span-5 2xl:p-10" style="{{ 'indigo' | accent }}">
        <div class="absolute inset-0 -z-10 bg-gradient-to-br from-indigo-700 via-iris-700 to-ocean-800" aria-hidden="true"></div>
        <div class="bg-confetti absolute inset-0 -z-10 opacity-25" aria-hidden="true"></div>
        <span class="grid size-14 place-items-center rounded-2xl bg-white/15 ring-1 ring-white/30">{% icon "book-open-check", "size-7" %}</span>
        <h3 class="mt-5 font-display text-2xl font-extrabold text-balance sm:text-3xl">{{ "service.learn.study_title" | t(L) }}</h3>
        <p class="mt-3 leading-relaxed text-white/90">{{ "service.learn.study_body" | t(L) }}</p>
        <ul class="mt-6 space-y-2.5 text-[15px]">
          {%- for sr in [study, sharing] %}{% if sr %}
          <li class="flex items-start gap-3"><span class="mt-0.5">{% icon "clock", "size-4" %}</span><span><strong>{{ ("service.learn.study_part" if loop.first else "service.learn.sharing_part") | t(L) }}</strong> · {{ sr | loc("pattern", L) }}</span></li>
          {%- endif %}{% endfor %}
          {%- if not study %}<li class="flex items-start gap-3"><span class="mt-0.5">{% icon "clock", "size-4" %}</span><span>{{ "service.learn.study_when" | t(L) }}</span></li>{% endif %}
          <li class="flex items-start gap-3"><span class="mt-0.5">{% icon "video", "size-4" %}</span><span>{{ "service.learn.study_where" | t(L) }}</span></li>
        </ul>
        {%- set so = (study.online if study else null) -%}
        {%- if so and so.zoomId %}
        <div class="mt-6 grid grid-cols-1 gap-2 sm:grid-cols-2">
          <div class="rounded-2xl bg-white/12 px-4 py-3 ring-1 ring-white/25" x-data="copyText({{ so.zoomId | json }})">
            <p class="text-[11px] font-bold tracking-wider text-white/90 uppercase">{{ "service.next.zoom_id" | t(L) }}</p>
            <button type="button" @click="copy()" class="mt-0.5 flex min-h-11 w-full items-center justify-between gap-2 font-mono text-lg font-bold lg:min-h-0" aria-label="{{ 'ui.copy_x' | t(L, { what: ('service.next.zoom_id' | t(L)) + ' ' + so.zoomId }) }}">{{ so.zoomId }}<span x-show="!copied">{% icon "copy", "size-4 opacity-80" %}</span><span x-cloak x-show="copied">{% icon "check", "size-4" %}</span></button>
          </div>
          {%- if so.passcode %}
          <div class="rounded-2xl bg-white/12 px-4 py-3 ring-1 ring-white/25" x-data="copyText({{ so.passcode | json }})">
            <p class="text-[11px] font-bold tracking-wider text-white/90 uppercase">{{ "service.next.passcode" | t(L) }}</p>
            <button type="button" @click="copy()" class="mt-0.5 flex min-h-11 w-full items-center justify-between gap-2 font-mono text-lg font-bold lg:min-h-0" aria-label="{{ 'ui.copy_x' | t(L, { what: ('service.next.passcode' | t(L)) + ' ' + so.passcode }) }}">{{ so.passcode }}<span x-show="!copied">{% icon "copy", "size-4 opacity-80" %}</span><span x-cloak x-show="copied">{% icon "check", "size-4" %}</span></button>
          </div>
          {%- endif %}
        </div>
        {%- endif %}
        <div class="mt-6 flex flex-wrap gap-2.5">
          {%- if so and so.joinUrl %}<a href="{{ so.joinUrl }}" target="_blank" rel="noopener" class="btn bg-white text-ink-950 shadow-soft hover:-translate-y-0.5">{% icon "video", "size-4 text-iris-600" %}{{ "service.next.join" | t(L) }}</a>{% endif %}
          {%- if study and study.next %}
          <a href="{{ study.url | lurl(L) }}" class="btn svc-glass" data-hide-after="{{ study.next.end }}">{% icon "calendar-check", "size-4" %}{{ "service.learn.next" | t(L, { date: (study.next.start | dt("date", L)) }) }}</a>
          {%- endif %}
        </div>
      </article>

      {#- other service events through the year -#}
      {%- set evs = [
        { key: "gsrschool", icon: "graduation-cap", color: "lime", url: "/committees/gsr-school/", series: gsrs, kind: "" },
        { key: "preconf", icon: "list-checks", color: "iris", url: "/service/delegate/#pre-conference", kind: "preconf" },
        { key: "foro", icon: "messages-square", color: "copper", url: "/service/area-meetings/", kind: "foro" },
        { key: "servathon", icon: "hand-helping", color: "blush", url: "/service/area-meetings/", kind: "servathon" },
        { key: "dcm4", icon: "handshake", color: "violet", url: "/committees/dcm-school/", kind: "", lastSeries: ((calendar.series or []) | svcMatch("title", "(4|four)[- ]?areas?.{0,3}dcm") | sortBy("startDate", "desc") | first) }
      ] -%}
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:col-span-7">
        {%- for e in evs %}
        {%- set found = null -%}
        {%- set last = null -%}
        {%- if e.kind -%}
          {%- for o in areaAll -%}
            {%- set k = o | svcKind(o | svcSeries(calendar)) -%}
            {%- if k == e.kind -%}
              {%- if (o.end | svcIsPast) -%}{%- set last = o -%}{%- elif not found -%}{%- set found = o -%}{%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
        <a href="{{ (found.url if found else e.url) | lurl(L) }}" class="card card-hover group flex flex-col gap-3 p-5 2xl:p-6 {{ 'sm:col-span-2' if loop.first }}" style="{{ e.color | accent }}">
          <div class="flex items-start gap-4">
            <span class="icon-tile transition group-hover:scale-110">{% icon e.icon, "size-6" %}</span>
            <div class="min-w-0 flex-1">
              <p class="text-xs font-bold tracking-wider text-(--a-700) uppercase">{{ ("service.learn." + e.key + "_when") | t(L) }}</p>
              <h3 class="mt-1 font-display text-lg font-bold text-ink-950">{{ ("service.learn." + e.key + "_title") | t(L) }}</h3>
            </div>
          </div>
          <p class="text-[15px] leading-relaxed text-ink-600">{{ ("service.learn." + e.key + "_body") | t(L) }}</p>
          <p class="mt-auto flex flex-wrap items-center gap-2 text-sm font-semibold text-(--a-700)">
            {%- if e.series and e.series.next %}
            {% icon "calendar-check", "size-4" %}<span>{{ "service.learn.next" | t(L, { date: (e.series.next.start | dt("date", L)) }) }}</span>
            {%- elif found %}
            {% icon "calendar-check", "size-4" %}<span>{{ "service.learn.next" | t(L, { date: (found.start | dt("date", L)) }) }}</span>
            {%- set fh = found | svcHosts(found | svcSeries(calendar)) %}{% if fh.length %}<span class="font-normal text-ink-500">· {% for h in fh %}{{ "service.district_n" | t(L, { n: h | svcDistrictNum }) }}{% if not loop.last %}, {% endif %}{% endfor %}</span>{% endif %}
            {%- elif last %}
            {% icon "history", "size-4" %}<span>{{ "service.learn.last" | t(L, { date: (last.start | dt("full", L)) }) }}</span>
            {%- elif e.lastSeries and e.lastSeries.next %}
            {% icon "calendar-check", "size-4" %}<span>{{ "service.learn.next" | t(L, { date: (e.lastSeries.next.start | dt("date", L)) }) }}</span>
            {%- elif e.lastSeries %}
            {% icon "history", "size-4" %}<span>{{ "service.learn.last" | t(L, { date: (e.lastSeries.start | dt("full", L)) }) }}</span>
            {%- else %}
            {% icon "arrow-right", "size-4" %}<span>{{ "ui.read_more" | t(L) }}</span>
            {%- endif %}
          </p>
        </a>
        {%- endfor %}
      </div>
    </div>
  </section>

  {#- ============================================================ documents -#}
  {%- set latest = documents.latest if documents else null -%}
  <section aria-labelledby="docs-title">
    {{ sectionHead({ eyebrow: "service.docs.eyebrow" | t(L), title: "service.docs.title" | t(L), lead: "service.docs.lead" | t(L), id: "docs-title", accent: "sea", action: { label: "service.docs.all" | t(L), url: "/documents/" | lurl(L), icon: "arrow-right" } }) }}
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {%- for col in [["minutes", "notebook-pen", "ocean", "/documents/minutes/"], ["motions", "gavel", "sun", "/service/motions/"], ["reports", "chart-column", "sage", "/documents/reports/"]] %}
      <div class="card p-5 2xl:p-6 {{ 'md:col-span-2 lg:col-span-1' if loop.last }}" style="{{ col[2] | accent }}">
        <div class="mb-2 flex items-center justify-between gap-3">
          <h3 class="flex items-center gap-2.5 font-display text-lg font-bold text-ink-950"><span class="icon-tile size-9 rounded-xl">{% icon col[1], "size-[18px]" %}</span>{{ ("service.docs." + col[0]) | t(L) }}</h3>
          <a href="{{ col[3] | lurl(L) }}" class="text-sm font-semibold text-(--a-700) hover:underline">{{ "ui.see_all" | t(L) }}</a>
        </div>
        {%- if col[0] == "motions" %}
        {#- the motions on the floor (data/motions.csv), not agenda files -#}
        {{ motionRows({ items: openMotions, lang: L, limit: 5 }) }}
        {%- else %}
        {{ docRows({ docs: (latest[col[0]] if latest else []), lang: L, limit: 5 }) }}
        {%- endif %}
      </div>
      {%- endfor %}
    </div>
  </section>
</div>
