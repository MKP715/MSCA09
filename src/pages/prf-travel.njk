---
pagination: { data: langs, size: 1, alias: lang, addAllPagesToCollections: true }
permalink: "{{ lang.prefix }}/service/prf-2028/travel/"
layout: page.njk
title_key: prf.travel.title
title_suffix_key: prf.title_suffix
description_key: prf.travel.description
eyebrow_key: prf.travel.eyebrow
lead_key: prf.travel.lead
heroIcon: map-pinned
accent: ocean
crumbs: [{ label_key: "prf.crumb_service", url: "/service/" }, { label_key: "prf.crumb", url: "/service/prf-2028/" }]
bare: true
prfPage: travel
ogImage: /assets/img/prf/long-beach-1024.jpg
# the photo's size and type, so a link preview can show it on the first share
ogImageWidth: 1024
ogImageHeight: 553
ogImageType: image/jpeg
og_image_alt_key: prf.flyer.photo_alt
source: data/prf/places.csv
scripts: ["/assets/js/prf.js"]
jsText: ["prf.js.to", "prf.js.subject"]
---
{#- Getting to the Forum: the hotel (room block, parking, amenities) and a map, airports and other ways to get there,
    things to do nearby, and the ride share / room share form (an e-mail to the host committee).
    Data: data/prf/forum.csv (hotel), places.csv, cards.csv (amenities, ways, savetips); wording: data/text/prf.csv. -#}
{%- from "macros/ui.njk" import sectionHead, mapBlock, copyable with context -%}
{%- from "macros/content.njk" import copyRow with context -%}
{%- from "macros/prf.njk" import prfMailForm with context -%}
{%- set L = lang -%}
{%- set P = prf -%}
{%- set S = P.set -%}
{%- set address = S.venue_street + ", " + S.venue_city + " " + S.venue_zip -%}
{%- set pins = [] -%}
{%- for p in P.mapPoints %}{% set _x = pins.push({ lat: p.lat, lng: p.lng, color: p.color, num: p.num, label: (p.label_es if (L.code == "es" and p.label_es) else p.label) }) %}{% endfor -%}
{%- set tba = "prf.tba" | t(L) -%}

{% include "partials/prf-nav.njk" %}

<div class="wrap space-y-20 py-12 lg:space-y-24 lg:py-16 2xl:py-20">

  {#- ============================================================ hotel + map -#}
  <section class="grid grid-cols-1 gap-6 lg:grid-cols-12" aria-labelledby="prf-hotel-h">
    <div class="card p-6 sm:p-8 lg:col-span-5" style="{{ 'coral' | accent }}">
      <span class="chip chip-accent">{{ "prf.travel.forum_hotel" | t(L) }}</span>
      <h2 id="prf-hotel-h" class="mt-3 font-display text-3xl font-extrabold text-ink-950">{{ S.venue_name }}</h2>
      <p class="mt-1 flex items-start gap-2 text-ink-600">{% icon "map-pin", "size-4 mt-1 shrink-0" %}<span>{{ address }}</span></p>
      <div class="mt-4 flex flex-wrap gap-2">
        <a href="https://www.google.com/maps/dir/?api=1&destination={{ (S.venue_name + ', ' + address) | urlencode }}" target="_blank" rel="noopener" class="btn btn-accent btn-sm">{% icon "navigation", "size-4" %}{{ "prf.travel.directions" | t(L) }}</a>
        {%- if S.hotel_url %}<a href="{{ S.hotel_url }}" target="_blank" rel="noopener" class="btn btn-white btn-sm">{% icon "hotel", "size-4" %}{{ "prf.travel.hotel_site" | t(L) }}</a>{% endif %}
      </div>
      <dl class="mt-6 divide-y divide-ink-100 text-sm">
        <div class="flex items-start justify-between gap-4 py-2.5"><dt class="flex items-center gap-2 text-ink-600">{% icon "tag", "size-4" %}{{ "prf.travel.rate" | t(L) }}</dt><dd class="text-right font-semibold text-ink-900">{{ S.hotel_rate or tba }}</dd></div>
        <div class="flex items-start justify-between gap-4 py-2.5"><dt class="flex items-center gap-2 text-ink-600">{% icon "link", "size-4" %}{{ "prf.travel.booking" | t(L) }}</dt>
          <dd class="text-right font-semibold text-ink-900">{% if S.booking_url %}<a href="{{ S.booking_url }}" target="_blank" rel="noopener" class="text-ocean-700 underline">{{ "prf.travel.book_now" | t(L) }}</a>{% if S.group_code %} · {{ "prf.travel.code" | t(L) }} {{ S.group_code }}{% endif %}{% if S.booking_cutoff %}<span class="block text-xs font-normal text-ink-500">{{ "prf.travel.cutoff" | t(L, { date: S.booking_cutoff | dt("full", L) }) }}</span>{% endif %}{% else %}{{ "prf.travel.booking_soon" | t(L) }}{% endif %}</dd></div>
        <div class="flex items-start justify-between gap-4 py-2.5"><dt class="flex items-center gap-2 text-ink-600">{% icon "car-front", "size-4" %}{{ "prf.travel.parking" | t(L) }}</dt><dd class="text-right font-semibold text-ink-900">{{ "prf.travel.parking_value" | t(L) }}</dd></div>
      </dl>
      <ul class="mt-4 space-y-2 text-sm text-ink-700" role="list">
        {%- for c in P.cards.amenities %}<li class="flex items-start gap-2.5">{% icon c.icon, "size-4 mt-0.5 shrink-0 text-(--a-600)" %}<span>{{ c | loc("body", L) }}</span></li>{% endfor %}
      </ul>
      <p class="mt-5 text-xs leading-relaxed text-ink-500">{{ "prf.travel.hotel_note" | t(L) }}</p>
      <div class="mt-5">{{ copyRow({ label: "prf.travel.address" | t(L), value: S.venue_name + ", " + address, lang: L }) }}</div>
    </div>

    <div class="flex flex-col gap-3 lg:col-span-7">
      {{ mapBlock({ id: "prf-travel-map", points: pins, height: "h-[26rem] lg:h-full lg:min-h-[34rem]", lang: L, cluster: false }) }}
      <ul class="flex flex-wrap gap-x-4 gap-y-1.5 text-sm text-ink-600" role="list" aria-label="{{ 'prf.travel.map_key' | t(L) }}">
        {%- for k in [["hotel", "coral"], ["airport", "ocean"], ["sight", "iris"], ["food", "sun"], ["transit", "sage"]] %}
        <li class="inline-flex items-center gap-1.5"><span class="size-3 rounded-full" style="background: var(--color-{{ k[1] }}-700)"></span>{{ ("prf.travel.pin_" + k[0]) | t(L) }}</li>
        {%- endfor %}
      </ul>
    </div>
  </section>

  {#- ============================================================ getting there -#}
  <section aria-labelledby="prf-there-h">
    {{ sectionHead({ eyebrow: "prf.travel.there_eyebrow" | t(L), title: "prf.travel.there_title" | t(L), id: "prf-there-h", accent: "ocean" }) }}
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-12">
      <div class="card self-start overflow-hidden lg:col-span-7" style="{{ 'ocean' | accent }}">
        <h3 class="flex items-center gap-3 border-b border-ink-100 p-6 font-display text-xl font-bold text-ink-950"><span class="icon-tile size-10 rounded-xl">{% icon "plane", "size-5" %}</span>{{ "prf.travel.airports" | t(L) }}</h3>
        <div class="overflow-x-auto">
          <table class="prf-table">
            <thead><tr><th scope="col">{{ "prf.travel.airport" | t(L) }}</th><th scope="col" class="text-right">{{ "prf.travel.distance" | t(L) }}</th><th scope="col" class="text-right">{{ "prf.travel.drive" | t(L) }}</th></tr></thead>
            <tbody>
              {%- for a in P.places.airport %}
              <tr>
                <th scope="row"><a href="{{ a.url }}" target="_blank" rel="noopener" class="font-bold text-ocean-700 hover:underline">{{ a.code }}</a> <span class="font-normal text-ink-700">{{ a | loc("name", L) }}</span></th>
                <td class="text-right whitespace-nowrap">{{ a | loc("dist", L) }}</td>
                <td class="text-right whitespace-nowrap">{{ a | loc("drive", L) }}</td>
              </tr>
              {%- endfor %}
            </tbody>
          </table>
        </div>
        <p class="p-6 pt-3 text-xs text-ink-500">{{ "prf.travel.airport_note" | t(L) }}</p>
      </div>
      <ul class="grid grid-cols-1 gap-4 lg:col-span-5" role="list">
        {%- for c in P.cards.ways %}
        <li class="card flex items-start gap-4 p-5" style="{{ ['sea', 'iris', 'sage', 'coral'][loop.index0 % 4] | accent }}">
          <span class="icon-tile size-11 shrink-0 rounded-xl">{% icon c.icon, "size-5" %}</span>
          <span class="min-w-0">
            <span class="block font-display text-lg font-bold text-ink-950">{{ c | loc("title", L) }}</span>
            <span class="mt-0.5 block text-ink-600">{{ c | loc("body", L) }}</span>
            {%- if c.url %}<a href="{{ c.url }}" {% if not c.url.startsWith('#') %}target="_blank" rel="noopener"{% endif %} class="mt-1.5 inline-flex items-center gap-1 text-sm font-semibold text-(--a-700) hover:underline">{{ c | loc("link", L) }}{% if c.url.startsWith('#') %}{% icon "arrow-down", "size-3.5" %}{% else %}{% icon "external-link", "size-3.5" %}{% endif %}</a>{% endif %}
          </span>
        </li>
        {%- endfor %}
      </ul>
    </div>
  </section>
</div>

{#- ============================================================ things to do -#}
<section class="prf-band" aria-labelledby="prf-todo-h">
  <div class="wrap py-14 lg:py-16">
    <div class="mb-8 flex flex-col gap-3 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <p class="eyebrow mb-2 !text-sun-200">{{ "prf.travel.todo_eyebrow" | t(L) }}</p>
        <h2 id="prf-todo-h" class="font-display text-4xl font-extrabold text-white">{{ "prf.travel.todo_title" | t(L) }}</h2>
      </div>
      <p class="flex max-w-xl items-start gap-2 text-white/80">{% icon "cloud-sun", "size-5 mt-0.5 shrink-0 text-sun-300" %}<span>{{ "prf.travel.weather" | t(L) }}</span></p>
    </div>
    <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3" role="list">
      {%- for p in P.places.todo %}
      <li>
        <a href="{{ p.url }}" target="_blank" rel="noopener" class="group flex h-full items-start gap-4 rounded-2xl bg-white/[0.06] p-5 ring-1 ring-white/10 transition hover:bg-white/[0.1]">
          <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-sun-300 text-ink-950">{% icon p.icon or "map-pin", "size-5" %}</span>
          <span class="min-w-0 flex-1">
            <span class="flex items-center gap-1.5 font-display text-lg font-bold text-white group-hover:underline">{{ p | loc("name", L) }}{% icon "external-link", "size-3.5 shrink-0 opacity-60" %}</span>
            <span class="mt-0.5 block text-white/80">{{ p | loc("body", L) }}</span>
            {%- if p.dist_en %}<span class="mt-2 inline-block rounded-full bg-white/10 px-2.5 py-0.5 text-xs font-semibold text-sun-200">{{ p | loc("dist", L) }}</span>{% endif %}
          </span>
        </a>
      </li>
      {%- endfor %}
    </ul>
    <p class="mt-6 text-sm text-white/70">{{ "prf.travel.todo_note" | t(L) }}</p>
  </div>
</section>

<div class="wrap py-16 lg:py-20">
  {#- ============================================================ ride share & room share -#}
  <section id="share" class="scroll-mt-28 grid grid-cols-1 gap-8 lg:grid-cols-12" aria-labelledby="prf-share-h">
    <div class="lg:col-span-4">
      <p class="eyebrow mb-2" style="{{ 'sage' | accent }}">{{ "prf.travel.share_eyebrow" | t(L) }}</p>
      <h2 id="prf-share-h" class="h-section">{{ "prf.travel.share_title" | t(L) }}</h2>
      <p class="lead mt-3">{{ "prf.travel.share_lead" | t(L) }}</p>
      <ul class="mt-6 space-y-3" role="list">
        {%- for c in P.cards.savetips %}<li class="flex items-start gap-2.5 text-ink-700">{% icon "piggy-bank", "size-5 mt-0.5 shrink-0 text-sage-600" %}<span>{{ c | loc("body", L) }}</span></li>{% endfor %}
      </ul>
      <p class="mt-6 flex items-start gap-2.5 rounded-2xl bg-ocean-50 p-4 text-sm text-ink-700 ring-1 ring-ocean-100">{% icon "shield-alert", "size-5 mt-0.5 shrink-0 text-ocean-700" %}<span>{{ "prf.travel.share_safety" | t(L) }}</span></p>
    </div>
    <div class="card p-6 sm:p-8 lg:col-span-8">
      {{ prfMailForm({ form: "ride", lang: L }) }}
    </div>
  </section>
</div>
