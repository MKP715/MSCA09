---
pagination: { data: langs, size: 1, alias: lang, addAllPagesToCollections: true }
permalink: "{{ lang.prefix }}/committees/"
layout: page.njk
title_key: committees.title
description_key: committees.description
eyebrow_key: committees.eyebrow
lead_key: committees.lead
heroIcon: users-round
accent: sage
crumbs: []
bare: true
scripts: ["/assets/js/committees.js"]
---
{%- from "macros/committees.njk" import committeeCard with context -%}
{%- from "macros/ui.njk" import emailLink with context -%}
{%- set L = lang -%}
{%- set groups = committees.groups or [] -%}
{%- set st = committees.stats or {} -%}
{%- set nSchools = (committees.list or []) | where("category", "school") | length -%}
{%- set nextArea = calendar.nextAreaMeeting if calendar else null -%}

{#- ---------------------------------------------------------------- at a glance -#}
<section x-data class="wrap -mt-6 relative z-10 lg:-mt-10" aria-label="{{ 'committees.glance' | t(L) }}">
  <div class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4 2xl:gap-6">
    <a href="#group-standing" class="card card-hover flex items-center gap-4 p-4 sm:p-5" style="{{ 'ocean' | accent }}">
      <span class="icon-tile hidden sm:grid">{% icon "users-round", "size-6" %}</span>
      <span><span class="block font-display text-3xl font-extrabold text-ink-950 2xl:text-4xl"><span x-data="countUp({{ st.standing or 0 }})" x-intersect.once="start()" x-text="display">{{ st.standing or 0 }}</span></span><span class="block text-sm font-medium text-ink-500">{{ "committees.stat_standing" | t(L) }}</span>{% if nSchools %}<span class="block text-xs font-semibold text-ocean-700">{{ "committees.stat_schools" | t(L, { n: nSchools }) }}</span>{% endif %}</span>
    </a>
    <a href="#group-coordinate" class="card card-hover flex items-center gap-4 p-4 sm:p-5" style="{{ 'iris' | accent }}">
      <span class="icon-tile hidden sm:grid">{% icon "badge-check", "size-6" %}</span>
      <span><span class="block font-display text-3xl font-extrabold text-ink-950 2xl:text-4xl"><span x-data="countUp({{ st.serving or 0 }})" x-intersect.once="start()" x-text="display">{{ st.serving or 0 }}</span></span><span class="block text-sm font-medium text-ink-500">{{ "committees.stat_serving" | t(L) }}</span></span>
    </a>
    <button type="button" @click="$dispatch('cm-help-wanted')" class="card card-hover flex items-center gap-4 p-4 text-left sm:p-5" style="{{ 'coral' | accent }}">
      <span class="icon-tile hidden sm:grid">{% icon "hand-heart", "size-6" %}</span>
      <span><span class="block font-display text-3xl font-extrabold text-coral-700 2xl:text-4xl"><span x-data="countUp({{ st.open or 0 }})" x-intersect.once="start()" x-text="display">{{ st.open or 0 }}</span></span><span class="block text-sm font-medium text-ink-500">{{ "committees.stat_open" | t(L) }}</span></span>
    </button>
    {%- if nextArea %}
    <a href="{{ nextArea.url | lurl(L) }}" class="card card-hover flex items-center gap-4 p-4 sm:p-5" style="{{ 'sun' | accent }}" data-hide-after="{{ nextArea.end }}" data-when="{{ nextArea.start }}" data-until="{{ nextArea.end }}">
      <span class="icon-tile hidden sm:grid">{% icon "calendar-clock", "size-6" %}</span>
      <span class="min-w-0"><span class="block font-display text-xl leading-tight font-extrabold text-ink-950 2xl:text-2xl">{{ nextArea.start | dt("short", L) }} <span data-rel hidden class="ml-1 align-middle text-xs font-bold text-sun-700"></span></span><span class="block text-sm font-medium text-ink-500">{{ "committees.stat_next_area" | t(L) }}</span></span>
    </a>
    {%- else %}
    <a href="{{ '/calendar/' | lurl(L) }}" class="card card-hover flex items-center gap-4 p-4 sm:p-5" style="{{ 'sun' | accent }}">
      <span class="icon-tile hidden sm:grid">{% icon "calendar-clock", "size-6" %}</span>
      <span><span class="block font-display text-xl leading-tight font-extrabold text-ink-950">{{ "committees.second_sunday" | t(L) }}</span><span class="block text-sm font-medium text-ink-500">{{ "committees.stat_next_area" | t(L) }}</span></span>
    </a>
    {%- endif %}
  </div>
</section>

<div x-data="cmFilter({ group: 'all' })" data-results="{{ 'committees.results' | t(L) }}" @cm-help-wanted.window="openOnly = true; group = 'all'; $nextTick(() => document.getElementById('cm-results').scrollIntoView({ behavior: MSCA.reducedMotion ? 'auto' : 'smooth' }))" class="mt-10 lg:mt-14">

  {#- ---------------------------------------------------------------- sticky toolbar -#}
  <div class="cm-toolbar" style="{{ 'sage' | accent }}">
    <div class="wrap flex flex-col gap-3 py-3 lg:flex-row lg:items-center lg:gap-6">
      <label class="relative hidden lg:block lg:w-80 2xl:w-96" :class="showSearch && '!block'">
        <span class="sr-only">{{ "committees.search_label" | t(L) }}</span>
        <span class="pointer-events-none absolute top-1/2 left-4 -translate-y-1/2 text-ink-400">{% icon "search", "size-5" %}</span>
        <input type="search" x-ref="q" x-model.debounce.150ms="q" class="field min-h-11 pl-12" placeholder="{{ 'committees.search_placeholder' | t(L) }}" autocomplete="off">
      </label>
      <nav aria-label="{{ 'committees.groups_nav' | t(L) }}" class="-mx-4 flex gap-2 overflow-x-auto px-4 no-scrollbar sm:-mx-6 sm:px-6 lg:mx-0 lg:flex-1 lg:flex-wrap lg:px-0">
        <button type="button" class="cm-pill lg:hidden" :aria-expanded="showSearch.toString()" @click="showSearch = !showSearch; $nextTick(() => showSearch && $refs.q.focus())" aria-label="{{ 'committees.search_label' | t(L) }}">{% icon "search", "size-4" %}</button>
        <button type="button" class="cm-pill" :aria-pressed="(group === 'all').toString()" @click="group = 'all'">{{ "ui.all" | t(L) }}</button>
        {%- for g in groups %}
        <button type="button" class="cm-pill" style="{{ g.color | accent }}" :aria-pressed="(group === '{{ g.key }}').toString()" @click="group = '{{ g.key }}'">{% icon g.icon, "size-4" %}{{ g | loc("label", L) }}<span class="cm-count">{{ g.items.length }}</span></button>
        {%- endfor %}
        <button type="button" class="cm-pill" style="{{ 'coral' | accent }}" :aria-pressed="openOnly.toString()" @click="openOnly = !openOnly">{% icon "hand-heart", "size-4" %}{{ "committees.help_wanted" | t(L) }}<span class="cm-count">{{ committees.stats.helpWanted or 0 }}</span></button>
      </nav>
    </div>
  </div>

  {#- ---------------------------------------------------------------- groups -#}
  <div id="cm-results" class="wrap scroll-mt-20 py-10 lg:py-14">
    <p class="sr-only" aria-live="polite" x-text="announce"></p>
    {%- for g in groups %}
    <section id="group-{{ g.key }}" class="cm-section mb-14 last:mb-0 lg:mb-20" data-cm-section data-group="{{ g.key }}" style="{{ g.color | accent }}" aria-labelledby="group-{{ g.key }}-title">
      <div class="cm-group-head">
        <div class="flex max-w-3xl items-start gap-4">
          <span class="icon-tile size-14 rounded-2xl">{% icon g.icon, "size-7" %}</span>
          <div>
            <h2 id="group-{{ g.key }}-title" class="font-display text-2xl font-bold tracking-tight text-ink-950 sm:text-3xl 2xl:text-4xl">{{ g | loc("label", L) }}</h2>
            {%- set ab = g | loc("about", L) %}{% if ab %}<p class="mt-1.5 text-ink-600 lg:text-lg">{{ ab }}</p>{% endif %}
          </div>
        </div>
        <span class="chip chip-accent">{{ "committees.n_items" | t(L, { n: g.items.length }) }}</span>
      </div>
      {#- phones: a swipeable rail per group; tablets and up: a grid with no more columns than cards,
          and groups of one or two get wide horizontal cards on large screens instead of leaving most of the row empty -#}
      {%- set n = g.items.length %}
      {%- if n <= 2 %}{% set gridCols = "lg:grid-cols-2" %}{% elif n == 3 %}{% set gridCols = "lg:grid-cols-3" %}{% elif n == 4 %}{% set gridCols = "lg:grid-cols-2 xl:grid-cols-4" %}{% else %}{% set gridCols = "lg:grid-cols-3 xl:grid-cols-4 3xl:grid-cols-5" %}{% endif %}
      <div class="rail scroll-px-4 sm:mx-0 sm:grid sm:grid-cols-2 sm:gap-5 sm:overflow-visible sm:px-0 sm:pb-0 {{ gridCols }} 2xl:gap-6">
        {%- for c in g.items %}
        {{ committeeCard({ c: c, lang: L, index: loop.index0, calendar: calendar, horizontal: n <= 2, cls: "w-[82vw] max-w-[21rem] shrink-0 sm:w-auto sm:max-w-none" + (" sm:col-span-2 lg:col-span-1" if n == 1 else "") }) }}
        {%- endfor %}
        {#- groups of three or more: a "visitors welcome" tile fills the empty cells of the last row at each width
            (columns per width as in gridCols above: sm 2, lg 3/2, xl 4/3, 3xl 5/4/3). Hidden while a filter is on. -#}
        {%- if n >= 3 %}
        {%- set cols = [2, 3, 3, 3] if n == 3 else ([2, 2, 4, 4] if n == 4 else [2, 3, 4, 5]) %}
        {%- set spanCls = [["", "sm:col-span-1"], ["", "lg:col-span-1", "lg:col-span-2"], ["", "xl:col-span-1", "xl:col-span-2", "xl:col-span-3"], ["", "3xl:col-span-1", "3xl:col-span-2", "3xl:col-span-3", "3xl:col-span-4"]] %}
        {%- set showCls = [["sm:hidden", "sm:flex"], ["lg:hidden", "lg:flex"], ["xl:hidden", "xl:flex"], ["3xl:hidden", "3xl:flex"]] %}
        {%- set fillCls = [] %}
        {%- for k in [0, 1, 2, 3] %}{% set fill = (cols[k] - (n % cols[k])) % cols[k] %}{% set _ = fillCls.push(showCls[k][1 if fill else 0]) %}{% if fill %}{% set _ = fillCls.push(spanCls[k][fill]) %}{% endif %}{% endfor %}
        {%- set openIn = [] %}{% for c in g.items %}{% if c.vacancies.length %}{% set _ = openIn.push(c.slug) %}{% endif %}{% endfor %}
        <div class="cm-fill @container hidden {{ fillCls | join(' ') }}" x-show="!q && group === 'all' && lang === 'all' && !openOnly">
          <div class="flex flex-1 flex-col gap-4 @lg:flex-row @lg:items-center @lg:gap-6">
            <span class="icon-tile size-12 shrink-0 rounded-2xl">{% icon "door-open", "size-6" %}</span>
            <div class="min-w-0 flex-1">
              <h3 class="font-display text-lg leading-snug font-bold text-ink-950">{{ "committees.fill_title" | t(L) }}</h3>
              <p class="mt-1 text-[15px] leading-relaxed text-ink-600">{{ "committees.fill_body" | t(L) }}</p>
            </div>
            <div class="flex flex-wrap gap-2 @lg:shrink-0 @lg:flex-col @3xl:flex-row">
              <a href="{{ '/calendar/' | lurl(L) }}" class="btn btn-ghost btn-sm bg-white">{% icon "calendar-days", "size-4" %}{{ "committees.see_calendar" | t(L) }}</a>
              {%- if openIn.length %}<button type="button" class="btn btn-sm btn-accent" style="{{ 'coral' | accent }}" @click="$dispatch('cm-help-wanted')">{% icon "hand-heart", "size-4" %}{{ "committees.see_open" | t(L) }}</button>{% endif %}
            </div>
          </div>
        </div>
        {%- endif %}
      </div>
    </section>
    {%- endfor %}

    <div x-cloak x-show="shown === 0" class="card flex flex-col items-center gap-3 p-10 text-center" style="{{ 'ocean' | accent }}">
      <span class="icon-tile-soft size-14">{% icon "search-x", "size-7" %}</span>
      <p class="font-display text-lg font-bold text-ink-900">{{ "ui.no_results" | t(L) }}</p>
      <button type="button" class="btn btn-ghost" @click="q = ''; group = 'all'; openOnly = false">{{ "ui.clear" | t(L) }}</button>
    </div>
  </div>
</div>

{#- ---------------------------------------------------------------- Area officers -#}
{%- set officers = committees.officers or [] -%}
{%- if officers.length %}
<section class="bg-ring-soft py-14 lg:py-20" aria-labelledby="officers-title">
  <div class="wrap">
    <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div class="max-w-3xl" style="{{ 'iris' | accent }}">
        <p class="eyebrow mb-2">{{ "committees.officers_eyebrow" | t(L) }}</p>
        <h2 id="officers-title" class="h-section">{{ "committees.officers_title" | t(L) }}</h2>
        <p class="lead mt-3">{{ "committees.officers_lead" | t(L) }}</p>
      </div>
      <a href="{{ '/about/panel/' | lurl(L) }}" class="btn btn-ghost shrink-0 bg-white">{{ "committees.see_panel" | t(L) }}{% icon "arrow-right", "size-4" %}</a>
    </div>
    <ul class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4 2xl:grid-cols-8">
      {%- for o in officers %}
      {%- set holder = o.chairs[0] %}
      <li style="{{ o.color | accent(loop.index0) }}">
        <a href="{{ ('/about/panel/#' + o.slug) | lurl(L) }}" class="card card-hover group flex h-full flex-col gap-3 p-5">
          <span class="icon-tile transition group-hover:scale-110">{% icon o.icon, "size-6" %}</span>
          <span class="font-display text-base leading-snug font-bold text-ink-950">{{ o | loc("name", L) }}</span>
          {%- if holder and holder.name %}<span class="text-sm font-semibold text-[var(--a-700)]">{{ holder.name }}{% if holder.unconfirmed %} <span class="font-normal text-ink-500">· {{ "people.to_confirm" | t(L) }}</span>{% endif %}</span>{% endif %}
          <span class="mt-auto text-sm text-ink-500">{{ o | loc("summary", L) }}</span>
        </a>
      </li>
      {%- endfor %}
      <li>
        <a href="{{ '/about/panel/' | lurl(L) }}" class="cm-ring-deep group flex h-full min-h-40 flex-col justify-between gap-3 rounded-3xl p-5 text-white shadow-glow transition hover:-translate-y-1">
          <span class="grid size-12 place-items-center rounded-2xl bg-white/15 ring-1 ring-white/30">{% icon "contact", "size-6" %}</span>
          <span class="font-display text-lg leading-snug font-bold">{{ "committees.meet_all" | t(L) }}</span>
          <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-white">{{ "committees.see_panel" | t(L) }}{% icon "arrow-right", "size-4 transition group-hover:translate-x-1" %}</span>
        </a>
      </li>
    </ul>
  </div>
</section>
{%- endif %}

{#- ---------------------------------------------------------------- how to serve -#}
<section class="wrap py-14 lg:py-20" aria-labelledby="serve-title">
  <div class="cm-ring-deep relative overflow-hidden rounded-[2rem] p-8 text-white shadow-glow sm:p-10 lg:p-14">
    <div class="bg-confetti pointer-events-none absolute inset-0 opacity-25" aria-hidden="true"></div>
    <div class="relative grid gap-10 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-5">
        <p class="text-xs font-bold tracking-[0.18em] text-white/90 uppercase">{{ "committees.serve_eyebrow" | t(L) }}</p>
        <h2 id="serve-title" class="mt-2 font-display text-3xl font-extrabold tracking-tight text-balance sm:text-4xl 2xl:text-5xl">{{ "committees.serve_title" | t(L) }}</h2>
        <p class="mt-4 text-lg text-white/95">{{ "committees.serve_lead" | t(L) }}</p>
      </div>
      <ol class="grid gap-4 sm:grid-cols-3 lg:col-span-7">
        {%- for i in [1, 2, 3] %}
        <li class="rounded-3xl bg-ink-950/15 p-5 ring-1 ring-white/25 backdrop-blur-md">
          <span class="grid size-10 place-items-center rounded-full bg-white font-display text-lg font-extrabold text-iris-700">{{ i }}</span>
          <h3 class="mt-3 font-display text-lg font-bold">{{ ("committees.serve_step" + i + "_title") | t(L) }}</h3>
          <p class="mt-1 text-sm leading-relaxed text-white/95">{{ ("committees.serve_step" + i + "_body") | t(L) }}</p>
        </li>
        {%- endfor %}
      </ol>
    </div>
    <div class="relative mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
      <button type="button" class="btn btn-white btn-lg whitespace-normal" @click="$dispatch('cm-help-wanted')" x-data>{% icon "hand-heart", "size-5 shrink-0" %}{{ "committees.see_open" | t(L) }}</button>
      <a href="mailto:chair@msca09aa.org" class="btn cm-glass btn-lg whitespace-normal">{% icon "mail", "size-5 shrink-0" %}{{ "committees.write_chair" | t(L) }}</a>
      <a href="{{ '/calendar/' | lurl(L) }}" class="btn cm-glass btn-lg whitespace-normal">{% icon "calendar-days", "size-5 shrink-0" %}{{ "committees.see_calendar" | t(L) }}</a>
    </div>
  </div>
</section>
