---
pagination: { data: langs, size: 1, alias: lang, addAllPagesToCollections: true }
permalink: "{{ lang.prefix }}/service/prf-2028/about/"
layout: page.njk
title_key: prf.about.title
title_suffix_key: prf.title_suffix
description_key: prf.about.description
eyebrow_key: prf.about.eyebrow
lead_key: prf.about.lead
heroIcon: messages-square
accent: sea
crumbs: [{ label_key: "prf.crumb_service", url: "/service/" }, { label_key: "prf.crumb", url: "/service/prf-2028/" }]
bare: true
prfPage: about
ogImage: /assets/img/prf/long-beach-1024.jpg
# the photo's size and type, so a link preview can show it on the first share
ogImageWidth: 1024
ogImageHeight: 553
ogImageType: image/jpeg
og_image_alt_key: prf.flyer.photo_alt
source: data/prf/cards.csv
scripts: ["/assets/js/prf.js"]
---
{#- What a Regional Forum is: history and purpose, who speaks, recent Pacific Forums, what happens over the weekend,
    tips for a first Forum, the 15 areas of the Pacific Region (map and list), anonymity, safety and accessibility,
    and links. Data: data/prf/cards.csv (history, hear, expect, tips), timeline.csv (forums), areas.csv, links.csv;
    wording: data/text/prf.csv. -#}
{%- from "macros/ui.njk" import sectionHead, mapBlock with context -%}
{%- set L = lang -%}
{%- set P = prf -%}
{%- set S = P.set -%}
{%- set historyDoc = documents.all | find("id", S.history_doc) -%}
{%- set bidDoc = documents.all | find("id", S.bid_doc) -%}

{% include "partials/prf-nav.njk" %}

<div class="wrap space-y-20 py-12 lg:space-y-24 lg:py-16 2xl:py-20">

  {#- ============================================================ history + who speaks + recent Forums -#}
  <section class="grid grid-cols-1 gap-10 lg:grid-cols-12" aria-labelledby="prf-hist-h">
    <div class="lg:col-span-7 2xl:col-span-8">
      {{ sectionHead({ eyebrow: "prf.about.hist_eyebrow" | t(L), title: "prf.about.hist_title" | t(L), id: "prf-hist-h", accent: "sea" }) }}
      <div class="prose-msca prose-lg max-w-none">
        {%- for c in P.cards.history %}<p>{{ c | loc("body", L) }}</p>{% endfor %}
      </div>
      <div class="mt-6 flex flex-wrap gap-2">
        {%- if historyDoc and historyDoc.url %}<a href="{{ historyDoc.url }}" target="_blank" rel="noopener" class="btn btn-white btn-sm">{% icon "file-text", "size-4 text-coral-600" %}{{ "prf.about.hist_pdf" | t(L) }}</a>{% endif %}
        <a href="{{ S.forums_url }}" target="_blank" rel="noopener" class="btn btn-white btn-sm">{% icon "external-link", "size-4 text-ocean-600" %}{{ "prf.about.forums_link" | t(L) }}</a>
        <a href="{{ S.video_url }}" target="_blank" rel="noopener" class="btn btn-white btn-sm">{% icon "circle-play", "size-4 text-iris-600" %}{{ "prf.home.video" | t(L) }}</a>
      </div>
    </div>

    <aside class="space-y-6 lg:col-span-5 2xl:col-span-4">
      <div class="card p-6" style="{{ 'iris' | accent }}">
        <h3 class="flex items-center gap-3 font-display text-xl font-bold text-ink-950"><span class="icon-tile size-10 rounded-xl">{% icon "mic", "size-5" %}</span>{{ "prf.about.hear_title" | t(L) }}</h3>
        <ul class="mt-4 space-y-2.5" role="list">
          {%- for c in P.cards.hear %}
          <li class="flex items-start gap-2.5 text-ink-700">{% icon "user-round", "size-4 mt-1 shrink-0 text-(--a-600)" %}<span>{{ c | loc("body", L) }}</span></li>
          {%- endfor %}
        </ul>
      </div>
      <div class="card p-6" style="{{ 'coral' | accent }}">
        <h3 class="flex items-center gap-3 font-display text-xl font-bold text-ink-950"><span class="icon-tile size-10 rounded-xl">{% icon "history", "size-5" %}</span>{{ "prf.about.past_title" | t(L) }}</h3>
        <ol class="prf-timeline prf-timeline--sm mt-5" role="list">
          {%- for f in P.timeline.forums %}
          <li class="prf-timeline__item{{ (' is-' + f.state) if f.state }}">
            <p class="prf-timeline__title">{{ f | loc("when", L) }} — {{ f | loc("title", L) }}</p>
            {%- if f.body_en %}<p class="prf-timeline__body">{{ f | loc("body", L) }}</p>{% endif %}
          </li>
          {%- endfor %}
        </ol>
        <a href="{{ S.reports_url }}" target="_blank" rel="noopener" class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-(--a-700) hover:underline">{% icon "book-open-text", "size-4" %}{{ "prf.about.reports" | t(L) }}</a>
      </div>
    </aside>
  </section>

  {#- ============================================================ what to expect -#}
  <section aria-labelledby="prf-expect-h">
    {{ sectionHead({ eyebrow: "prf.about.expect_eyebrow" | t(L), title: "prf.about.expect_title" | t(L), lead: "prf.about.expect_lead" | t(L), id: "prf-expect-h", accent: "coral", align: "center" }) }}
    <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-3" role="list">
      {%- for c in P.cards.expect %}
      <li class="card reveal p-6" style="{{ ['sea', 'coral', 'iris', 'sun', 'sage', 'ocean', 'copper', 'blush', 'lilac'][loop.index0 % 9] | accent }}; --reveal-delay: {{ (loop.index0 % 3) * 70 }}ms">
        <span class="icon-tile size-12">{% icon c.icon, "size-6" %}</span>
        <h3 class="mt-4 font-display text-lg font-bold text-ink-950">{{ c | loc("title", L) }}</h3>
        <p class="mt-1.5 leading-relaxed text-ink-600">{{ c | loc("body", L) }}</p>
      </li>
      {%- endfor %}
    </ul>
  </section>
</div>

{#- ============================================================ first Forum -#}
<section class="prf-band" aria-labelledby="prf-first-h">
  <div class="wrap grid grid-cols-1 gap-10 py-14 lg:grid-cols-12 lg:py-16">
    <div class="lg:col-span-5">
      <p class="eyebrow mb-2 !text-sun-200">{{ "prf.about.first_eyebrow" | t(L) }}</p>
      <h2 id="prf-first-h" class="font-display text-4xl font-extrabold text-white">{{ "prf.about.first_title" | t(L) }}</h2>
      <p class="mt-4 text-lg leading-relaxed text-white/85">{{ "prf.about.first_lead" | t(L) }}</p>
      <p class="mt-5 flex items-start gap-2.5 rounded-2xl bg-white/10 p-4 text-white/90">{% icon "sparkles", "size-5 mt-0.5 shrink-0 text-sun-300" %}<span>{{ "prf.about.first_stat" | t(L) }}</span></p>
    </div>
    <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:col-span-7" role="list">
      {%- for c in P.cards.tips %}
      <li class="reveal flex items-start gap-4 rounded-2xl bg-white/[0.06] p-5 ring-1 ring-white/10" style="--reveal-delay: {{ (loop.index0 % 2) * 70 }}ms">
        <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-sun-300 text-ink-950">{% icon c.icon, "size-5" %}</span>
        <span><span class="block font-display text-lg font-bold text-white">{{ c | loc("title", L) }}</span><span class="mt-1 block text-white/80">{{ c | loc("body", L) }}</span></span>
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>

<div class="wrap space-y-20 py-16 lg:space-y-24 lg:py-20">

  {#- ============================================================ the Pacific Region -#}
  <section id="region" class="scroll-mt-28" aria-labelledby="prf-region-h">
    {{ sectionHead({ eyebrow: "prf.about.region_eyebrow" | t(L), title: "prf.about.region_title" | t(L), lead: "prf.about.region_lead" | t(L), id: "prf-region-h", accent: "sage" }) }}
    <div class="grid grid-cols-1 gap-6 xl:grid-cols-12">
      <ul class="grid grid-cols-1 gap-2.5 sm:grid-cols-2 xl:col-span-6" role="list">
        {%- for a in P.areas %}
        {#- our own Area: its home page within the site, in the page's language (ownUrl), in the same tab -#}
        {%- set aUrl = a.url | ownUrl(L) %}
        <li>
          <a href="{{ aUrl }}"{% if not aUrl.startsWith("/") %} target="_blank" rel="noopener"{% endif %} class="prf-area{{ ' is-host' if a.host }}">
            <span class="prf-area__num">{{ a.num }}</span>
            <span class="min-w-0 flex-1">
              <span class="block font-semibold text-ink-900">{{ a | loc("name", L) }}</span>
              <span class="block text-xs text-ink-500">{% if a.host %}{{ "prf.about.host_area" | t(L) }}{% else %}{{ a.state }}{% endif %}</span>
            </span>
            {% icon "arrow-right" if aUrl.startsWith("/") else "external-link", "size-4 shrink-0 text-ink-300" %}
          </a>
        </li>
        {%- endfor %}
      </ul>
      <div class="xl:col-span-6">
        {%- set areaPins = [] %}{% for p in P.areaPoints %}{% set _x = areaPins.push({ lat: p.lat, lng: p.lng, label: p.label, url: p.url | ownUrl(L), color: p.color, num: p.num }) %}{% endfor %}
        {{ mapBlock({ id: "prf-region-map", points: areaPins, height: "h-[24rem] xl:h-full xl:min-h-[30rem]", lang: L }) }}
      </div>
    </div>
    <p class="mt-4 flex items-start gap-2 text-sm text-ink-500">{% icon "info", "size-4 mt-0.5 shrink-0" %}<span>{{ "prf.about.area_note" | t(L) }} <a href="https://www.aa.org/list-of-general-service-conference-area-web-sites-uscanada" target="_blank" rel="noopener" class="font-semibold text-ocean-700 hover:underline">aa.org</a>.</span></p>
  </section>

  {#- ============================================================ anonymity · safety · accessibility -#}
  <section aria-labelledby="prf-care-h">
    <h2 id="prf-care-h" class="sr-only">{{ "prf.about.care_title" | t(L) }}</h2>
    <ul class="grid grid-cols-1 gap-5 lg:grid-cols-3" role="list">
      {%- for c in [["anon", "eye-off", "iris", "https://www.aa.org/anonymity-online-and-digital-media"], ["safe", "shield-check", "sage", "https://www.aa.org/safety-card-aa-groups"], ["acc", "accessibility", "ocean", "https://www.aa.org/accessibility-resources"]] %}
      <li class="card reveal flex flex-col p-6" style="{{ c[2] | accent }}; --reveal-delay: {{ loop.index0 * 80 }}ms">
        <h3 class="flex items-center gap-3 font-display text-xl font-bold text-ink-950"><span class="icon-tile size-11">{% icon c[1], "size-5" %}</span>{{ ("prf.about." + c[0] + "_title") | t(L) }}</h3>
        <p class="mt-3 flex-1 leading-relaxed text-ink-600">{{ ("prf.about." + c[0] + "_body") | t(L) }}</p>
        <a href="{{ c[3] }}" target="_blank" rel="noopener" class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-(--a-700) hover:underline">{{ ("prf.about." + c[0] + "_link") | t(L) }}{% icon "external-link", "size-3.5" %}</a>
      </li>
      {%- endfor %}
    </ul>
  </section>

  {#- ============================================================ resources -#}
  <section id="resources" class="scroll-mt-28" aria-labelledby="prf-res-h">
    {{ sectionHead({ eyebrow: "prf.res.eyebrow" | t(L), title: "prf.res.title" | t(L), lead: "prf.res.lead" | t(L), id: "prf-res-h", accent: "ocean" }) }}
    <div class="grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-4">
      {#- the Forum's own documents, from the document library -#}
      <div class="card reveal p-6" style="{{ 'coral' | accent }}">
        <h3 class="flex items-center gap-2.5 font-display text-lg font-bold text-ink-950">{% icon "folder-open", "size-5 text-(--a-600)" %}{{ "prf.res.docs" | t(L) }}</h3>
        <ul class="mt-4 space-y-3.5" role="list">
          {%- if historyDoc and historyDoc.url %}
          <li><a href="{{ historyDoc.url }}" target="_blank" rel="noopener" class="prf-reslink">{{ "prf.res.history" | t(L) }}{% icon "file-text", "size-3.5 shrink-0" %}</a><span class="prf-resdesc">{{ "prf.res.history_desc" | t(L) }}</span></li>
          {%- endif %}
          {%- if bidDoc and bidDoc.url %}
          <li><a href="{{ bidDoc.url }}" target="_blank" rel="noopener" class="prf-reslink">{{ "prf.res.bid" | t(L) }}{% icon "file-text", "size-3.5 shrink-0" %}</a><span class="prf-resdesc">{{ "prf.res.bid_desc" | t(L) }}</span></li>
          {%- endif %}
          <li><a href="{{ '/service/delegate/' | lurl(L) }}" class="prf-reslink">{{ "prf.res.delegate" | t(L) }}{% icon "arrow-right", "size-3.5 shrink-0" %}</a><span class="prf-resdesc">{{ "prf.res.delegate_desc" | t(L) }}</span></li>
          <li><a href="{{ '/about/structure/' | lurl(L) }}" class="prf-reslink">{{ "prf.res.structure" | t(L) }}{% icon "arrow-right", "size-3.5 shrink-0" %}</a><span class="prf-resdesc">{{ "prf.res.structure_desc" | t(L) }}</span></li>
        </ul>
      </div>
      {%- for g in [["forums", "messages-square", "sea"], ["safety", "shield-check", "sage"], ["service", "network", "iris"]] %}
      <div class="card reveal p-6" style="{{ g[2] | accent }}; --reveal-delay: {{ loop.index * 70 }}ms">
        <h3 class="flex items-center gap-2.5 font-display text-lg font-bold text-ink-950">{% icon g[1], "size-5 text-(--a-600)" %}{{ ("prf.res.group_" + g[0]) | t(L) }}</h3>
        <ul class="mt-4 space-y-3.5" role="list">
          {%- for l in P.links[g[0]] %}
          <li><a href="{{ l | loc("url", L) }}" target="_blank" rel="noopener" class="prf-reslink">{{ l | loc("title", L) }}{% if l.pdf == 'yes' %}{% icon "file-text", "size-3.5 shrink-0" %}{% else %}{% icon "external-link", "size-3.5 shrink-0" %}{% endif %}</a><span class="prf-resdesc">{{ l | loc("desc", L) }}</span></li>
          {%- endfor %}
        </ul>
      </div>
      {%- endfor %}
    </div>
    <p class="mt-6"><a href="{{ '/resources/' | lurl(L) }}" class="btn btn-ghost">{% icon "book-open", "size-4" %}{{ "prf.res.more" | t(L) }}{% icon "arrow-right", "size-4" %}</a></p>
  </section>
</div>
