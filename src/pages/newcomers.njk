</section>

{#- ============================================================ ABOUT THE AREA -#}
<section aria-labelledby="area-note-title" class="pb-6">
  <div class="wrap">
    <div class="flex flex-col items-start gap-6 rounded-[2rem] bg-ink-950 p-8 text-ink-200 sm:p-10 lg:flex-row lg:items-center lg:gap-10 lg:p-12">
      <img src="/assets/img/logo/logo-{{ L.code }}-160.webp" alt="" width="96" height="96" loading="lazy" class="size-20 shrink-0 rounded-full bg-white p-1 lg:size-24">
      <div class="flex-1">
        <h2 id="area-note-title" class="font-display text-2xl font-bold text-white">{{ "newcomers.area_title" | t(L) }}</h2>
        <p class="mt-2 max-w-4xl leading-relaxed">{{ "newcomers.area_body" | t(L) }}</p>
      </div>
      <a href="{{ '/about/' | lurl(L) }}" class="btn btn-white shrink-0">{{ "newcomers.area_cta" | t(L) }}{% icon "arrow-right", "size-4" %}</a>
    </div>
  </div>
</section>

<a href="#call" x-data="callFab('call')" :class="off && 'is-hidden'" class="call-fab" aria-label="{{ 'newcomers.fab' | t(L) }}">{% icon "phone", "size-5" %}{{ "newcomers.fab" | t(L) }}</a>
