---
pagination:
  data: langs
  size: 1
  alias: lang
  addAllPagesToCollections: true
permalink: "{{ lang.prefix }}/calendar/"
layout: base.njk
title_key: calendar.title
meta_title_key: calendar.meta_title
description_key: calendar.description
accent: ocean
scripts: ["/assets/js/calendar.js"]
---
{#-
  /calendar/ — the Area calendar. From the top:
    1. a slim header (title, stats; the "Skip to the calendar" link jumps past 2)
    2. "Coming up: Area events & gatherings": the flyers of the next Area events — a swipeable row on phones and
       tablets; from 1024px one row of the grid, three full rows behind "Show more events". Its heading's buttons lead to
       /events/ and to every upcoming flyer (/calendar/flyers/, pages/calendar-flyers.njk); a link beside "Show more
       events" leads to the flyers too, at every width
    3. the calendar app:
         phones / tablets:  toolbar + calendar, rail below, filters in a drawer
         1280–1919px:       filters | calendar, the rail as a band under the calendar
         1920px and up:     filters | calendar | rail
       The calendar comes before the filters in the page (keyboard and screen-reader order); CSS grid areas
       put the filters on the left. A link with filters in the address (?committee=, ?district=, "Share this
       view") opens the page at the calendar, past the flyers (calendar.js jumpToCalendar)
    4. more ways to browse
-#}
{%- from "macros/events.njk" import upcomingList, officeEventCard -%}
{%- from "macros/ui.njk" import sectionHead, breadcrumbLd -%}
{%- set L = lang -%}
{%- set C = calendar -%}
<script type="application/json" id="cal-config">{{ C | calConfig(L, officeEvents) | json | safe }}</script>

{#- ---------------------------------------------------------- slim page header -#}
<section class="cal-hero relative isolate overflow-hidden" style="{{ 'ocean' | accent }}">
  <div class="cal-hero__bg absolute inset-0 -z-10" aria-hidden="true"></div>
  <div class="bg-confetti absolute inset-0 -z-10 opacity-60" aria-hidden="true"></div>
  <img src="/assets/img/logo/logo-{{ L.code }}-256.webp" alt="" aria-hidden="true" width="256" height="256" loading="lazy"
       class="pointer-events-none absolute -top-10 right-6 -z-10 hidden size-56 rotate-12 opacity-[0.07] lg:block 2xl:right-16">
  <div class="wrap pt-4 pb-5 sm:pt-5 lg:pt-6 lg:pb-7">
    <a href="#cal-main" class="cal-skip">{% icon "arrow-down", "size-4" %}{{ "calendar.skip" | t(L) }}</a>
    <nav aria-label="{{ 'nav.breadcrumb' | t(L) }}" class="mb-3 text-sm max-sm:hidden">
      <ol class="flex flex-wrap items-center gap-1.5 text-ink-500">
        <li><a href="{{ '/' | lurl(L) }}" class="inline-flex items-center gap-1 hover:text-ink-900">{% icon "house", "size-4" %}<span class="sr-only">{{ "nav.home" | t(L) }}</span></a></li>
        <li class="flex items-center gap-1.5">{% icon "chevron-right", "size-3.5 text-ink-300" %}<span class="font-medium text-ink-800" aria-current="page">{{ "calendar.title" | t(L) }}</span></li>
      </ol>
    </nav>
    {{ breadcrumbLd({ lang: L, crumbs: [], title: "calendar.title" | t(L), base: site.url }) }}
    <div class="flex flex-wrap items-center justify-between gap-x-10 gap-y-3 lg:flex-nowrap">
      <div class="flex min-w-0 flex-1 items-center gap-4">
        <span class="icon-tile hidden size-12 shrink-0 rounded-2xl sm:grid lg:size-14">{% icon "calendar-days", "size-6 lg:size-7" %}</span>
        <div class="min-w-0">
          <h1 class="font-display text-3xl font-extrabold tracking-tight text-balance text-ink-950 sm:text-4xl 2xl:text-5xl" data-pagefind-weight="10">{{ "calendar.title" | t(L) }}</h1>
          <p class="mt-1 text-[15px] leading-snug text-pretty text-ink-600 sm:text-base">{{ "calendar.lead" | t(L) }}</p>
          {#- the central offices' own events (read from their websites every day): their page, at every width -#}
          <a href="{{ '/calendar/central-offices/' | lurl(L) }}" class="mt-2 inline-flex items-center gap-1.5 text-sm font-semibold text-copper-700 hover:underline">{% icon "building-2", "size-4" %}{{ "calendar.offices.link" | t(L) }}{% icon "arrow-right", "size-3.5" %}</a>
        </div>
      </div>
      <dl class="cal-stats" aria-label="{{ 'calendar.stats.label' | t(L) }}">
        <div class="cal-stat" style="{{ 'ocean' | accent }}"><dt>{{ "calendar.stats.next30" | t(L) }}</dt><dd>{{ C.stats.occurrencesNext30Days }}</dd></div>
        <div class="cal-stat" style="{{ 'sea' | accent }}"><dt>{{ "calendar.stats.regular" | t(L) }}</dt><dd>{{ C.stats.series }}</dd></div>
        <div class="cal-stat" style="{{ 'coral' | accent }}"><dt>{{ "calendar.stats.events" | t(L) }}</dt><dd>{{ C.stats.eventsUpcoming }}</dd></div>
      </dl>
    </div>
  </div>
</section>

{#- ---------------------------------------------------------- featured events with flyers -#}
{#- 15 shown at most (three rows of 5 on wide screens, calendar.css .cal-feat), and 5 more in case some end before
    the next build (app.js removes them) -#}
{%- set featured = (C.featuredEvents or []) | limit(20) -%}
{%- if featured.length %}
<section class="cal-feat relative isolate overflow-hidden py-10 sm:py-12 lg:py-14 2xl:py-16" aria-labelledby="featured-title" style="{{ 'coral' | accent }}"
         x-data="calFeatured" :class="all && 'is-all'">
  <div class="absolute inset-0 -z-10 bg-ring-soft" aria-hidden="true"></div>
  <div class="wrap">
    {{ sectionHead({ eyebrow: "calendar.featured.eyebrow" | t(L), title: "calendar.featured.title" | t(L), lead: "calendar.featured.lead" | t(L), id: "featured-title",
                     actions: [{ label: "calendar.featured.all" | t(L), url: "/events/" | lurl(L) }, { label: "calendar.flyers.all" | t(L), url: "/calendar/flyers/" | lurl(L) }, { label: "calendar.offices.link" | t(L), url: "/calendar/central-offices/" | lurl(L) }] }) }}
    {#- phones and tablets: one swipeable row of 10 flyers (calendar.css .ev-grid--rail); from 1024px a grid that shows
        one row until "Show more events" opens three full rows (calendar.css .cal-feat), so the calendar stays near
        the top. The first
        flyer is the page's main picture: it loads at once, with high priority. The others are marked lazy, but a
        browser counts the next cards of the row as near and fetches a few at once anyway; on phones they share the
        connection with the first, which is why phones get files no wider than 640px (macros/events.njk _flyerImg).
        sizes follows those widths (a rail card is min(78vw, 20rem)) -#}
    {{ upcomingList({ items: featured, lang: L, limit: 15, variant: "flyer", id: "featured-events", class: "ev-grid ev-grid--flyer ev-grid--rail",
                      eager: 1, sizes: "(min-width: 1920px) 18vw, (min-width: 1536px) 22vw, (min-width: 1024px) 30vw, min(78vw, 20rem)" }) }}
    {#- "Show more events" (from 1024px, when the flyers fill at least two rows; it opens three full rows) and, at every
        width, the way to every upcoming flyer -#}
    <div class="cal-feat__foot">
      <div class="cal-feat__more">
        <button type="button" class="btn btn-ghost" x-cloak aria-controls="featured-events" :aria-expanded="all.toString()"
                @click="toggle($el)">
          <span x-show="!all">{{ "calendar.featured.more" | t(L) }}</span><span x-cloak x-show="all">{{ "ui.show_less" | t(L) }}</span>
          <span class="transition" :class="all && 'rotate-180'">{% icon "chevron-down", "size-4" %}</span>
        </button>
      </div>
      <a href="{{ '/calendar/flyers/' | lurl(L) }}" class="btn btn-ghost">{% icon "images", "size-4" %}{{ "calendar.flyers.see_all" | t(L) }}</a>
    </div>
  </div>
</section>
{%- endif %}

<div x-data="areaCalendar" @keydown.escape.window="closeAll()" class="cal-page" :class="tbOut && 'tb-out'">
  {#- ---------------------------------------------------------- calendar · filters · rail -#}
  <div class="wrap pt-6 sm:pt-8 lg:pt-10">
    <div class="cal-layout">
      {#- the calendar (first in the page: keyboard users reach it before the filters). The target of the header's
          "Skip to the calendar" link: it takes the keyboard here, so Tab goes on to the quick views -#}
      <section id="cal-main" class="cal-main min-w-0" aria-labelledby="cal-title" tabindex="-1">
        {% include "partials/calendar-toolbar.njk" %}
        {% include "partials/calendar-views.njk" %}
      </section>

      {#- filters: sticky sidebar from 1280px, a drawer below -#}
      <div x-cloak x-show="drawer" x-transition.opacity class="fixed inset-0 z-[60] bg-ink-950/45 backdrop-blur-sm xl:hidden" @click="closeDrawer()" aria-hidden="true"></div>
      <aside id="cal-filters" data-reload-safe class="cal-filters" :class="drawer && 'is-open'" aria-label="{{ 'ui.filters' | t(L) }}"
             x-trap.inert.noscroll="drawer && !xl" :aria-modal="(drawer && !xl) ? 'true' : null" :role="(!xl) ? 'dialog' : null">
        {% include "partials/calendar-filters.njk" %}
      </aside>

      {#- next Area meeting, this week, subscribe, find a meeting -#}
      <div class="cal-rail">
        {% include "partials/calendar-rail.njk" %}
      </div>
    </div>
  </div>

  {% include "partials/calendar-detail.njk" %}
</div>

{#- ---------------------------------------------------------- from the central offices -#}
{#- the next events the central offices post on their own websites (officeEvents, src/_data/officeEvents.js; the Area
    calendar's own entries are never repeated here): one swipeable row on phones and tablets, a grid from 1024px. Each
    card opens its card on /calendar/central-offices/, where the office's own page is linked -#}
{%- set coEvents = officeEvents.featured or [] -%}
{%- if coEvents.length %}
<section class="relative isolate overflow-hidden py-12 lg:py-16" aria-labelledby="co-strip-title" style="{{ 'copper' | accent }}">
  <div class="absolute inset-0 -z-10 bg-ring-soft opacity-70" aria-hidden="true"></div>
  <div class="wrap">
    {{ sectionHead({ eyebrow: "calendar.offices.strip_eyebrow" | t(L), title: "calendar.offices.strip_title" | t(L), lead: "calendar.offices.strip_lead" | t(L), id: "co-strip-title",
                     actions: [{ label: "calendar.offices.see_all" | t(L), url: "/calendar/central-offices/" | lurl(L) }] }) }}
    <ul id="co-strip" role="list" class="ev-grid ev-grid--flyer ev-grid--rail" data-pagefind-ignore="all">
      {%- for ev in coEvents %}
      {{ officeEventCard({ ev: ev, lang: L, offices: officeEvents.byKey, sizes: "(min-width: 1920px) 18vw, (min-width: 1536px) 22vw, (min-width: 1024px) 30vw, min(78vw, 20rem)" }) }}
      {%- endfor %}
    </ul>
    <div class="mt-6 flex flex-wrap gap-2">
      <a href="{{ '/calendar/central-offices/' | lurl(L) }}" class="btn btn-ghost">{% icon "building-2", "size-4" %}{{ "calendar.offices.see_all" | t(L) }}</a>
    </div>
  </div>
</section>
{%- endif %}

{#- ---------------------------------------------------------- browse more -#}
<section class="wrap py-16 lg:py-20" aria-labelledby="browse-title">
  <h2 id="browse-title" class="sr-only">{{ "calendar.browse.title" | t(L) }}</h2>
  <div class="reveal grid gap-5 md:grid-cols-2 xl:grid-cols-4">
    <a href="{{ '/events/' | lurl(L) }}#meetings" class="browse-card group" style="{{ 'sea' | accent }}">
      <span class="icon-tile">{% icon "repeat", "size-6" %}</span>
      <span class="min-w-0"><span class="browse-card__title">{{ "calendar.browse.meetings" | t(L) }}</span><span class="browse-card__body">{{ "calendar.browse.meetings_body" | t(L, { n: C.stats.series }) }}</span></span>
    </a>
    <a href="{{ '/events/' | lurl(L) }}#archive" class="browse-card group" style="{{ 'copper' | accent }}">
      <span class="icon-tile">{% icon "history", "size-6" %}</span>
      <span class="min-w-0"><span class="browse-card__title">{{ "calendar.browse.archive" | t(L) }}</span><span class="browse-card__body">{{ "calendar.browse.archive_body" | t(L, { n: C.stats.pastEvents }) }}</span></span>
    </a>
    <a href="{{ (C.embedUrlEs if L.code == 'es' else C.embedUrl) }}" target="_blank" rel="noopener" class="browse-card group" style="{{ 'iris' | accent }}">
      <span class="icon-tile">{% icon "calendar-check", "size-6" %}</span>
      <span class="min-w-0"><span class="browse-card__title">{{ "calendar.browse.google" | t(L) }}</span><span class="browse-card__body">{{ "calendar.browse.google_body" | t(L) }}</span></span>
    </a>
    <a href="{{ '/service/area-meetings/' | lurl(L) }}" class="browse-card group" style="{{ 'coral' | accent }}">
      <span class="icon-tile">{% icon "landmark", "size-6" %}</span>
      <span class="min-w-0"><span class="browse-card__title">{{ "calendar.browse.area" | t(L) }}</span><span class="browse-card__body">{{ "calendar.browse.area_body" | t(L) }}</span></span>
    </a>
  </div>
  <p class="mt-10 flex items-start gap-3 rounded-3xl bg-ink-50 p-5 text-sm leading-relaxed text-ink-600 sm:items-center">
    {% icon "info", "size-5 shrink-0 text-ocean-600" %}
    <span>{{ "calendar.footnote" | t(L, { date: C.generated | dt("date", L) }) }} <a href="mailto:{{ site.email_webmaster }}" class="font-semibold text-ocean-700 hover:underline">{{ site.email_webmaster }}</a></span>
  </p>
</section>
