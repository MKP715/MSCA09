---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
{#-
  Every indexable page (pages with noindex — the 404 page, the Spanish copies of the English-only
  Delegate's Corner archive, events and finished meeting series that ended more than two years ago —
  are left out; see sitemapEntries in eleventy.config.js). Forwarding pages (old addresses, old district
  numbers) are never in collections, so they are left out too; the old addresses have their own
  sitemap for Search Console (sitemap-old-addresses.njk).
  The other-language alternate is listed only when that page exists and is indexable.
  <lastmod> appears only for pages that give a real date (front matter `lastmod`; event pages use the
  day their calendar entry was last edited): a build time would change eight times a day and teach
  search engines to ignore it. After the build, scripts/sitemap-dates.mjs adds the day the page's text
  last changed (compared with the live site's /assets/data/page-dates.json) to the pages without one,
  and to an event page whose text changed after its calendar entry; never the build time either.
-#}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{%- for e in collections.all | sitemapEntries %}
  <url>
    <loc>{{ e.url | absUrl(site.url + "/") }}</loc>
    {#- right after <loc>: the sitemap schema wants loc, lastmod, then the other namespaces (xhtml:link) #}
    {%- if e.lastmod %}
    <lastmod>{{ e.lastmod }}</lastmod>
    {%- endif %}
    {%- if e.alt %}
    <xhtml:link rel="alternate" hreflang="{{ e.lang }}" href="{{ e.url | absUrl(site.url + '/') }}"/>
    <xhtml:link rel="alternate" hreflang="{{ e.altLang }}" href="{{ e.alt | absUrl(site.url + '/') }}"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ (e.alt if e.lang == 'es' else e.url) | absUrl(site.url + '/') }}"/>
    {%- endif %}
  </url>
{%- endfor %}
</urlset>
