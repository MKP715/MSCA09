---
pagination: { data: langs, size: 1, alias: lang, addAllPagesToCollections: true }
permalink: "{{ lang.prefix }}/contribute/"
layout: page.njk
title_key: contribute.title
description_key: contribute.description
eyebrow_key: contribute.eyebrow
lead_key: contribute.lead
heroIcon: heart
accent: coral
bare: true
scripts: ["/assets/js/content.js"]
---
{%- from "macros/content.njk" import faqList, resourceCard, quoteCard, pageNav, nextMeetingCard, copyRow with context -%}
{%- from "macros/ui.njk" import emailLink with context -%}
{%- set L = lang -%}
{%- set R = resources.byKey or {} -%}
{%- set qr = R['zelle-qr'] -%}
{%- set flyer = R['contribute-flyer'] -%}
{%- set zelleName = site.zelle_name or "Mid-Southern California Area Assembly of Alcoholics Anonymous" -%}
{%- set zelleMail = site.email_contributions or "contributions@msca09aa.org" -%}
{%- set addrLines = [site.mailing_name, site.mailing_po_box, site.mailing_city] | compact -%}
{%- set attn = "contribute.mail_attn" | t(L) -%}

<div class="wrap pt-2 pb-4">
  {{ pageNav({ lang: L, label: "content.on_this_page" | t(L), items: [
    { id: "ways", label: "contribute.nav_ways" | t(L), icon: "hand-coins", color: "coral" },
    { id: "include", label: "contribute.nav_include" | t(L), icon: "list-checks", color: "ocean" },
    { id: "why", label: "contribute.nav_why" | t(L), icon: "sprout", color: "sage" },
    { id: "beyond", label: "contribute.nav_beyond" | t(L), icon: "network", color: "iris" },
    { id: "faq", label: "contribute.nav_faq" | t(L), icon: "message-circle-question", color: "sun" }
  ] }) }}
</div>

{#- ============================================================ WAYS -#}
<section id="ways" aria-labelledby="ways-title" class="scroll-mt-28 bg-gradient-to-b from-coral-50/50 via-white to-white py-14 lg:py-20">
  <div class="wrap">
    <div class="mb-10 max-w-3xl">
      <p class="eyebrow mb-2" style="{{ 'coral' | accent }}">{% icon "hand-coins", "size-4" %}{{ "contribute.ways_eyebrow" | t(L) }}</p>
      <h2 id="ways-title" class="h-section text-balance">{{ "contribute.ways_title" | t(L) }}</h2>
      <p class="lead mt-3 text-pretty">{{ "contribute.ways_lead" | t(L) }}</p>
    </div>

    {#- Zelle runs the full width (three columns on wide screens); mail, in person and questions sit below it. -#}
    <div class="grid grid-cols-1 gap-6">
      {#- Zelle -#}
      <article class="card overflow-hidden" style="{{ 'iris' | accent }}" aria-labelledby="zelle-title">
        <header class="relative overflow-hidden px-6 py-6 text-white sm:px-8 lg:py-7" style="background: linear-gradient(115deg, var(--color-iris-800), var(--color-iris-700) 35%, var(--color-ocean-700) 75%, var(--color-sea-700));">
          <span class="pointer-events-none absolute -right-6 -bottom-8 text-white/15 lg:right-10" aria-hidden="true">{% icon "smartphone", "size-40" %}</span>
          <div class="relative flex flex-wrap items-end justify-between gap-x-8 gap-y-2">
            <div>
              <p class="text-xs font-bold tracking-[0.18em] uppercase">{{ "contribute.zelle_kicker" | t(L) }}</p>
              <h3 id="zelle-title" class="mt-1 font-display text-3xl font-extrabold lg:text-4xl">{{ "contribute.zelle_title" | t(L) }}</h3>
              <p class="mt-1 text-white">{{ "contribute.zelle_sub" | t(L) }}</p>
            </div>
            <p class="hidden max-w-md text-sm leading-relaxed text-white lg:mr-48 lg:block">{{ "contribute.zelle_note" | t(L) }}</p>
          </div>
        </header>
        {#- The QR code shows only while the zelle-qr row in data/resources.csv has show = yes
            (the Treasurer A/R test-scans it first). Without it, the typed instructions fill the card. -#}
        {#- {email} in a step becomes the Zelle ID in bold (added after Markdown, so it is not turned into a mailto link) -#}
        {%- set emailHtml = '<strong class="inline-block font-mono text-[0.95em] text-ink-950">' + ((zelleMail | escape) | replace("@", "@<wbr>")) + '</strong>' %}
        {%- set stepsHtml %}
          {%- for s in "contribute.zelle_step" | tlist(L) %}
          {%- set stepText = s.qr if (qr and s.qr) else s.text %}
          <li class="flex items-start gap-3">
            <span class="grid size-8 shrink-0 place-items-center rounded-full bg-gradient-to-br from-iris-600 to-ocean-700 font-display text-sm font-bold text-white shadow-soft">{{ loop.index }}</span>
            <span class="min-w-0 pt-0.5 leading-relaxed break-words text-ink-700 [&_strong]:font-bold [&_strong]:text-ink-950">{{ (stepText | mdi) | replace("{email}", emailHtml) | safe }}</span>
          </li>
          {%- endfor %}
        {%- endset %}
        {%- set checkHtml %}
        <div class="flex items-start gap-3 rounded-2xl bg-sun-50 p-4 text-sm leading-relaxed text-sun-950 ring-1 ring-sun-200 sm:p-5">
          {% icon "shield-check", "mt-0.5 size-5 shrink-0 text-sun-700" %}
          <p><strong class="font-bold">{{ "contribute.check_name_title" | t(L) }}</strong> {{ "contribute.check_name_body" | t(L, { name: zelleName, email: zelleMail }) }}</p>
        </div>
        {%- endset %}
        {%- if qr %}
        <div class="grid grid-cols-1 gap-8 p-6 sm:p-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_14rem] lg:items-start lg:gap-10">
          <div class="space-y-4">
            {{ copyRow({ label: "contribute.zelle_mail_label" | t(L), value: zelleMail, lang: L, mono: true, big: true }) }}
            {{ copyRow({ label: "contribute.zelle_name_label" | t(L), value: zelleName, lang: L }) }}
          </div>
          <div>
            <p class="mb-4 text-xs font-bold tracking-[0.16em] text-iris-700 uppercase">{{ "contribute.zelle_how" | t(L) }}</p>
            <ol class="space-y-4">{{ stepsHtml | safe }}</ol>
          </div>
          <figure class="mx-auto w-full max-w-[14rem] text-center">
            <div class="qr-frame">
              <div class="rounded-[1.25rem] bg-white p-3">
                <img src="{{ qr.url | driveImg(480) }}" alt="{{ 'contribute.qr_alt' | t(L) }}" width="384" height="508" loading="lazy" referrerpolicy="no-referrer" class="h-auto w-full rounded-lg"
                     onerror="this.onerror=null;this.src='https://drive.google.com/thumbnail?id={{ qr.url | driveId }}&sz=w480'">
              </div>
            </div>
            <figcaption class="mt-5 text-sm leading-snug font-semibold text-ink-800">{{ "contribute.qr_caption" | t(L) }}</figcaption>
          </figure>
        </div>
        <div class="px-6 pb-6 sm:px-8 sm:pb-8">{{ checkHtml | safe }}</div>
        {%- else %}
        {#- Without the QR code: what to type | how to send | the name check, side by side on wide screens -#}
        <div class="grid grid-cols-1 gap-8 p-6 sm:p-8 lg:grid-cols-2 lg:gap-10 xl:grid-cols-[minmax(0,1.05fr)_minmax(0,1.2fr)_minmax(0,0.9fr)]">
          <div class="space-y-4">
            {{ copyRow({ label: "contribute.zelle_mail_label" | t(L), value: zelleMail, lang: L, mono: true, big: true }) }}
            {{ copyRow({ label: "contribute.zelle_name_label" | t(L), value: zelleName, lang: L }) }}
          </div>
          <div>
            <p class="mb-4 text-xs font-bold tracking-[0.16em] text-iris-700 uppercase">{{ "contribute.zelle_how" | t(L) }}</p>
            <ol class="grid grid-cols-1 gap-4 md:grid-cols-2 md:gap-x-8 lg:grid-cols-1">{{ stepsHtml | safe }}</ol>
          </div>
          <div class="lg:col-span-2 xl:col-span-1">{{ checkHtml | safe }}</div>
        </div>
        {%- endif %}
      </article>

      {#- Check / money order / cash · in person · questions -#}
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 2xl:grid-cols-3">
        <article class="card flex flex-col overflow-hidden" style="{{ 'sea' | accent }}" aria-labelledby="mail-title">
          <header class="px-6 pt-6 sm:px-8 sm:pt-8">
            <span class="icon-tile">{% icon "mail", "size-6" %}</span>
            <h3 id="mail-title" class="mt-4 font-display text-2xl font-bold text-ink-950">{{ "contribute.mail_title" | t(L) }}</h3>
            <p class="mt-1 text-ink-600">{{ "contribute.mail_sub" | t(L) }}</p>
          </header>
          <div class="flex flex-1 flex-col gap-4 p-6 sm:p-8">
            <div class="rounded-2xl bg-sea-50 p-5 ring-1 ring-sea-200" x-data="copyText({{ (addrLines | join('\n') + '\n' + attn) | json }})">
              <p class="text-xs font-bold tracking-wide text-sea-800 uppercase">{{ "contribute.mail_label" | t(L) }}</p>
              <address class="mt-2 font-display text-lg leading-snug font-bold text-ink-950 not-italic">
                {%- for line in addrLines %}{{ line }}<br>{% endfor %}<span class="text-sea-800">{{ attn }}</span>
              </address>
              <button type="button" @click="copy()" class="btn btn-white btn-sm mt-4 min-h-11" aria-label="{{ 'contribute.copy_address' | t(L) }}">
                <span x-show="!copied" class="inline-flex items-center gap-1.5" aria-hidden="true">{% icon "copy", "size-3.5" %}{{ "contribute.copy_address" | t(L) }}</span>
                <span x-cloak x-show="copied" class="inline-flex items-center gap-1.5 text-sage-700" aria-hidden="true">{% icon "check", "size-3.5" %}{{ "ui.copied" | t(L) }}</span>
              </button>
              <span class="sr-only" role="status" x-text="copied ? {{ ('ui.copied' | t(L)) | json }} : ''"></span>
            </div>
            <p class="flex items-start gap-2 text-sm leading-relaxed text-ink-600">{% icon "info", "mt-0.5 size-4 shrink-0 text-sea-600" %}{{ "contribute.mail_note" | t(L) }}</p>
          </div>
        </article>

        <article class="card flex flex-col overflow-hidden" style="{{ 'sun' | accent }}" aria-labelledby="person-title">
          <header class="px-6 pt-6 sm:px-8 sm:pt-8">
            <span class="icon-tile">{% icon "hand-heart", "size-6" %}</span>
            <h3 id="person-title" class="mt-4 font-display text-2xl font-bold text-ink-950">{{ "contribute.person_title" | t(L) }}</h3>
            <p class="mt-1 text-ink-600">{{ "contribute.person_body" | t(L) }}</p>
          </header>
          <div class="mt-auto flex flex-col gap-3 p-6 sm:p-8">
            {%- if calendar and calendar.nextAreaMeeting %}{{ nextMeetingCard({ occ: calendar.nextAreaMeeting, lang: L }) }}{% endif %}
            <p class="text-sm leading-relaxed text-ink-600">{{ "contribute.person_when" | t(L) }}</p>
            <a href="{{ '/service/area-meetings/' | lurl(L) }}" class="btn btn-ghost self-start">{% icon "calendar-range", "size-4" %}{{ "contribute.person_cta" | t(L) }}</a>
          </div>
        </article>

        {#- questions: a strip under the two cards, or a third card on very wide screens -#}
        <div class="card grid grid-cols-1 content-start gap-4 p-6 sm:p-8 md:col-span-2 lg:grid-cols-12 lg:items-center 2xl:col-span-1 2xl:grid-cols-1 2xl:items-start" style="{{ 'ocean' | accent }}">
          <div class="lg:col-span-3 2xl:col-span-1">
            <span class="icon-tile mb-4 hidden 2xl:grid">{% icon "messages-square", "size-6" %}</span>
            <h3 class="font-display text-xl font-bold text-ink-950 2xl:text-2xl">{{ "contribute.questions_title" | t(L) }}</h3>
            <p class="mt-1 text-sm text-ink-500">{{ "contribute.questions_sub" | t(L) }}</p>
          </div>
          <ul class="grid grid-cols-1 gap-x-6 gap-y-4 sm:grid-cols-2 lg:col-span-9 2xl:col-span-1 2xl:grid-cols-1 2xl:gap-y-5">
            {%- for c in "contribute.contact" | tlist(L) %}
            <li class="min-w-0">
              <p class="text-xs font-bold tracking-wide text-ink-500 uppercase">{{ c.role }}</p>
              {#- the email cell may name a row of data/settings.csv (e.g. email_contributions) instead of an address -#}
              <div class="mt-1 text-[15px]">{{ emailLink({ email: (site[c.email] if (c.email and site[c.email]) else c.email), lang: L }) }}</div>
            </li>
            {%- endfor %}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

{#- ============================================================ WHAT TO INCLUDE -#}
<section id="include" aria-labelledby="include-title" class="scroll-mt-28 py-14 lg:py-20">
  <div class="wrap">
    <div class="mb-10 max-w-3xl">
      <p class="eyebrow mb-2" style="{{ 'ocean' | accent }}">{% icon "list-checks", "size-4" %}{{ "contribute.include_eyebrow" | t(L) }}</p>
      <h2 id="include-title" class="h-section text-balance">{{ "contribute.include_title" | t(L) }}</h2>
      <p class="lead mt-3 text-pretty">{{ "contribute.include_lead" | t(L) }}</p>
    </div>
    <div class="grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-4">
      {%- for it in "contribute.include" | tlist(L) %}
      <article class="reveal card card-accent flex flex-col gap-3 p-6 pt-7" style="{{ it.color | accent(loop.index0) }}; --reveal-delay:{{ loop.index0 * 80 }}ms">
        <span class="icon-tile">{% icon it.icon or "check", "size-6" %}</span>
        <h3 class="font-display text-xl font-bold text-ink-950">{{ it.title }}</h3>
        <p class="rounded-xl bg-[var(--a-50)] px-3 py-2 font-mono text-[15px] font-semibold text-[var(--a-800)]">{{ it.write }}</p>
        <div class="flex-1 text-[15px] leading-relaxed text-ink-600 [&_a]:font-semibold [&_a]:text-ocean-700 [&_a:hover]:underline">{{ it.body | mdi | safe }}</div>
      </article>
      {%- endfor %}
    </div>
  </div>
</section>

{#- ============================================================ WHY -#}
<section id="why" aria-labelledby="why-title" class="scroll-mt-28 bg-gradient-to-b from-sage-50/70 to-white py-14 lg:py-20">
  <div class="wrap">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-5 2xl:col-span-4">
        <p class="eyebrow mb-2" style="{{ 'sage' | accent }}">{% icon "sprout", "size-4" %}{{ "contribute.why_eyebrow" | t(L) }}</p>
        <h2 id="why-title" class="h-section text-balance">{{ "contribute.why_title" | t(L) }}</h2>
        <p class="lead mt-4 text-pretty">{{ "contribute.why_body" | t(L) }}</p>
      </div>
      {#- Where Area contributions go (repeating list contribute.goes.NN in data/text/content.csv) -#}
      <div class="lg:col-span-7 2xl:col-span-8">
        <div class="flex flex-wrap items-end justify-between gap-3">
          <h3 class="font-display text-xl font-bold text-ink-950">{{ "contribute.goes_title" | t(L) }}</h3>
          <a href="{{ '/documents/finances/' | lurl(L) }}" class="inline-flex min-h-11 items-center gap-1.5 text-sm font-semibold text-sage-800 hover:underline">{% icon "piggy-bank", "size-4" %}{{ "contribute.goes_cta" | t(L) }}{% icon "arrow-right", "size-4" %}</a>
        </div>
        <ul class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-3">
          {%- for it in "contribute.goes" | tlist(L) %}
          <li class="flex items-start gap-3 rounded-2xl bg-white p-4 shadow-soft ring-1 ring-ink-900/5" style="{{ it.color | accent(loop.index0) }}">
            <span class="icon-tile size-10 rounded-xl">{% icon it.icon or "circle", "size-5" %}</span>
            <span class="min-w-0"><span class="block font-display leading-snug font-bold text-ink-950">{{ it.title }}</span><span class="mt-0.5 block text-sm leading-snug text-ink-600">{{ it.body }}</span></span>
          </li>
          {%- endfor %}
        </ul>
        <p class="mt-3 text-xs leading-relaxed text-ink-500">{{ "contribute.goes_source" | t(L) }}</p>
      </div>
    </div>
    <div class="mt-10 grid grid-cols-1 gap-5 md:grid-cols-2 {{ 'xl:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_minmax(0,1.6fr)]' if L.code == 'en' }}">
      {{ quoteCard({ text: "contribute.trad7" | t(L), cite: "contribute.trad7_cite" | t(L), url: R['twelve-traditions'] | loc('url', L), color: "coral", size: "lg" }) }}
      {{ quoteCard({ text: "contribute.secondary_quote" | t(L), cite: "contribute.secondary_cite" | t(L), url: R.contributions | loc('url', L), color: "sun", size: "lg" }) }}
      {%- if L.code == "en" %}
      <div class="md:col-span-2 xl:col-span-1">{{ quoteCard({ text: "contribute.f3_quote" | t(L), cite: "contribute.f3_cite" | t(L), url: R['self-support-f3'] | loc('url', L), color: "sage" }) }}</div>
      {%- endif %}
    </div>
  </div>
</section>

{#- ============================================================ BEYOND THE AREA -#}
<section id="beyond" aria-labelledby="beyond-title" class="scroll-mt-28 bg-ring-soft py-14 lg:py-20">
  <div class="wrap">
    <div class="mb-10 grid grid-cols-1 gap-6 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="eyebrow mb-2" style="{{ 'iris' | accent }}">{% icon "network", "size-4" %}{{ "contribute.beyond_eyebrow" | t(L) }}</p>
        <h2 id="beyond-title" class="h-section text-balance">{{ "contribute.beyond_title" | t(L) }}</h2>
        <p class="lead mt-3 text-pretty">{{ "contribute.beyond_lead" | t(L) }}</p>
      </div>
      <p class="text-sm leading-relaxed text-ink-500 lg:col-span-5">{{ "contribute.beyond_note" | t(L) }}</p>
    </div>
    <div class="grid grid-cols-1 gap-5 md:grid-cols-2 2xl:grid-cols-4">
      {%- for it in "contribute.beyond" | tlist(L) %}
      <article class="reveal card flex flex-col gap-4 p-6 2xl:p-7" style="{{ it.color | accent(loop.index0) }}; --reveal-delay:{{ loop.index0 * 80 }}ms">
        <div class="flex items-center gap-3">
          <span class="icon-tile">{% icon it.icon or "circle", "size-6" %}</span>
          <h3 class="font-display text-xl font-bold text-ink-950">{{ it.title }}</h3>
        </div>
        <div class="flex-1 space-y-3 text-[15px] leading-relaxed text-ink-600 [&_a]:font-semibold [&_a]:text-ocean-700 [&_a:hover]:underline [&_strong]:text-ink-900">{{ it.body | md | safe }}</div>
        {%- if it.url %}
        <a href="{{ it.url | lurl(L) }}" {% if 'http' in it.url %}target="_blank" rel="noopener"{% endif %} class="btn btn-accent self-start">{{ it.cta }}{% if 'http' in it.url %}{% icon "external-link", "size-3.5 opacity-80" %}{% else %}{% icon "arrow-right", "size-4" %}{% endif %}</a>
        {%- endif %}
      </article>
      {%- endfor %}
    </div>
  </div>
</section>

{#- ============================================================ READING + FAQ -#}
<section id="faq" aria-labelledby="faq-title" class="scroll-mt-28 py-14 lg:py-20">
  <div class="wrap grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-12">
    <div class="lg:col-span-7 2xl:col-span-8">
      <p class="eyebrow mb-2" style="{{ 'sun' | accent }}">{% icon "message-circle-question", "size-4" %}{{ "contribute.faq_eyebrow" | t(L) }}</p>
      <h2 id="faq-title" class="h-section mb-8 text-balance">{{ "contribute.faq_title" | t(L) }}</h2>
      {{ faqList({ items: faq.byPage.contribute or [], lang: L, id: "contribute-faq" }) }}
    </div>
    <aside class="lg:col-span-5 2xl:col-span-4" aria-labelledby="reading-title">
      <div class="space-y-4 lg:sticky lg:top-32">
        <h2 id="reading-title" class="font-display text-2xl font-bold text-ink-950">{{ "contribute.reading_title" | t(L) }}</h2>
        <ul class="space-y-3">
          {%- for r in resources.byPage.contribute or [] %}
          <li>{{ resourceCard({ r: r, lang: L, index: loop.index0, compact: true }) }}</li>
          {%- endfor %}
        </ul>
        <div class="card p-5" style="{{ 'coral' | accent }}">
          <h3 class="font-display text-lg font-bold text-ink-950">{{ "contribute.print_title" | t(L) }}</h3>
          <p class="mt-1 text-sm text-ink-600">{{ "contribute.print_body" | t(L) }}</p>
          <div class="mt-4 flex flex-wrap gap-2">
            {%- if flyer %}
            <a href="{{ flyer.url | driveView }}" target="_blank" rel="noopener" class="btn btn-accent">{% icon "download", "size-4" %}{{ flyer | loc("title", L) }}</a>
            {%- endif %}
            <button type="button" onclick="window.print()" class="btn btn-ghost">{% icon "printer", "size-4" %}{{ "contribute.print_cta" | t(L) }}</button>
          </div>
        </div>
      </div>
    </aside>
  </div>
</section>
