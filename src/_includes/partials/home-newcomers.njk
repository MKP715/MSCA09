{#-
  "New to A.A.?" band: a welcome, a quotation from aa.org, and tap-to-call buttons for the local
  central offices (data/central-offices.csv, the same list as the Resources page).
  Phones list 3 offices, tablets and laptops 6, wide screens all; "Show more" opens the rest.
-#}
{%- set L = lang -%}
{%- set offices = (homeLinks.offices if homeLinks else []) | homeOfficeOrder(L) -%}
{%- set showSm = 3 -%}
{%- set show = 6 -%}
<section class="home-new relative isolate overflow-hidden py-10 sm:py-16 lg:py-24" aria-labelledby="home-new-title" x-data="{ all: false }">
  <div class="home-new-bg absolute inset-0 -z-10" aria-hidden="true"></div>
  <div class="wrap grid gap-10 lg:grid-cols-12 lg:gap-10 xl:gap-12 2xl:gap-16">
    <div class="min-w-0 lg:col-span-4 xl:col-span-5" style="{{ 'coral' | accent }}">
      <p class="eyebrow mb-2">{% icon "heart-handshake", "size-4" %}{{ "home.new.eyebrow" | t(L) }}</p>
      <h2 id="home-new-title" class="h-section text-balance">{{ "home.new.title" | t(L) }}</h2>
      <figure class="hm-new-quote mt-6">
        <blockquote class="font-display text-lg leading-snug font-semibold text-ink-900 text-pretty sm:text-xl 2xl:text-2xl">
          <p>“{{ "home.new.quote" | t(L) }}”</p>
        </blockquote>
        <figcaption class="mt-3 text-sm text-ink-500">— <a href="{{ 'home.new.quote_url' | t(L) }}" target="_blank" rel="noopener" class="font-semibold text-ocean-700 hover:underline">{{ "home.new.quote_source" | t(L) }}</a></figcaption>
      </figure>
      <p class="lead mt-5 text-base text-pretty sm:mt-6 sm:text-lg 2xl:text-xl">{{ "home.new.lead" | t(L) }}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="{{ '/newcomers/' | lurl(L) }}" class="btn btn-primary btn-lg">{% icon "heart-handshake", "size-5" %}{{ "home.new.cta" | t(L) }}</a>
        {%- if site.aa_meeting_guide %}
        <a href="{{ site.aa_meeting_guide | replace('aa.org/', 'aa.org/es/') if L.code == 'es' else site.aa_meeting_guide }}" target="_blank" rel="noopener" class="btn btn-white btn-lg">{% icon "smartphone", "size-5 text-ocean-600" %}{{ "home.new.app" | t(L) }}{% icon "external-link", "size-4 opacity-60" %}</a>
        {%- endif %}
      </div>
    </div>

    <div class="min-w-0 lg:col-span-8 xl:col-span-7">
      <div class="hm-call-panel">
        <div class="flex flex-wrap items-end justify-between gap-3">
          <div>
            <h3 class="flex items-center gap-2 font-display text-2xl font-bold text-ink-950">{% icon "phone-call", "size-6 text-coral-600" %}{{ "home.new.call_title" | t(L) }}</h3>
            <p class="mt-1 text-sm text-ink-500">{{ "home.new.call_lead" | t(L) }}</p>
          </div>
          <a href="{{ '/resources/' | lurl(L) }}#offices" class="text-sm font-semibold text-ocean-700 hover:underline">{{ "home.new.all_offices" | t(L) }} →</a>
        </div>
        {%- if offices.length %}
        <ul class="mt-5 grid gap-3 sm:grid-cols-2 2xl:grid-cols-3" role="list">
          {%- for o in offices %}
          {%- set dists = (o.districts or "") | replace(";", ",") %}
          <li {% if loop.index0 >= show %}class="hm-more" :class="all && 'is-open'"{% elif loop.index0 >= showSm %}class="hm-more-sm" :class="all && 'is-open'"{% endif %}>
            <a href="{{ o.tel }}" class="hm-call-card group" style="{{ ('coral' if o.spanish else 'ocean') | accent }}">
              <span class="hm-call-ico">{% icon "phone", "size-5" %}</span>
              <span class="min-w-0 flex-1">
                <span class="block text-[15px] leading-snug font-semibold text-ink-900">{{ o | loc("name", L) }}</span>
                <span class="mt-0.5 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-ink-500">
                  {%- if dists %}<span>{{ "home.new.districts" | t(L, { list: dists }) }}</span>{% endif %}
                  {%- if o.spanish %}<span class="chip chip-accent px-2 py-0.5">{{ "language.spanish" | t(L) }}</span>{% endif %}
                  {%- if o.always %}<span class="chip chip-soft px-2 py-0.5">{% icon "clock", "size-3" %}24 h</span>{% endif %}
                </span>
                <span class="mt-1.5 block font-display text-lg font-bold tracking-tight text-(--a-700) group-hover:text-(--a-800)">{{ o.phone }}</span>
              </span>
            </a>
          </li>
          {%- endfor %}
        </ul>
        {%- if offices.length > showSm %}
        <button type="button" class="hm-more-btn {{ 'hm-more-btn--sm' if offices.length <= show }} btn btn-ghost mt-4 w-full sm:w-auto" x-cloak @click="all = !all" :aria-expanded="all.toString()">
          <span x-show="!all"><span class="hm-n-sm">{{ "home.new.more" | t(L, { n: offices.length - showSm }) }}</span>{% if offices.length > show %}<span class="hm-n-md">{{ "home.new.more" | t(L, { n: offices.length - show }) }}</span>{% endif %}</span>
          <span x-show="all" x-cloak>{{ "ui.show_less" | t(L) }}</span>
          <span class="transition" :class="all && 'rotate-180'">{% icon "chevron-down", "size-4" %}</span>
        </button>
        {%- endif %}
        {%- else %}
        <a href="{{ '/resources/' | lurl(L) }}#offices" class="btn btn-ocean mt-5">{% icon "phone", "size-4" %}{{ "home.new.all_offices" | t(L) }}</a>
        {%- endif %}
        <p class="mt-5 flex items-start gap-2 rounded-2xl bg-ocean-50 px-4 py-3 text-sm text-ink-700">{% icon "globe", "size-4 mt-0.5 shrink-0 text-ocean-600" %}<span>{{ "home.new.online" | t(L) }} <a href="https://aa-intergroup.org/{{ 'es/' if L.code == 'es' }}" target="_blank" rel="noopener" class="font-semibold whitespace-nowrap text-ocean-700 hover:underline">aa-intergroup.org</a></span></p>
      </div>
    </div>
  </div>
</section>
