{#- Quick actions: big colourful tiles from data/home-links.csv (compact two-column buttons on phones). -#}
{%- set L = lang -%}
{%- set tiles = homeLinks.tiles if homeLinks else [] -%}
{%- if tiles.length %}
<section class="home-actions relative isolate overflow-hidden py-10 sm:py-16 lg:py-20 2xl:py-24" aria-labelledby="home-actions-title">
  <div class="bg-ring-soft absolute inset-0 -z-10" aria-hidden="true"></div>
  <div class="wrap">
    <div class="mb-6 flex flex-col gap-3 sm:mb-8 lg:mb-10 lg:flex-row lg:items-end lg:justify-between" style="{{ 'iris' | accent }}">
      <div class="max-w-3xl">
        <p class="eyebrow mb-2 hidden sm:inline-flex">{{ "home.actions.eyebrow" | t(L) }}</p>
        <h2 id="home-actions-title" class="h-section text-balance">{{ "home.actions.title" | t(L) }}</h2>
      </div>
      <p class="lead hidden max-w-xl text-pretty sm:block lg:text-right">{{ "home.actions.lead" | t(L) }}</p>
    </div>
    <ul class="hm-action-grid" role="list">
      {%- for tile in tiles %}
      <li class="reveal" style="{{ tile.color | accent(loop.index0) }}; --reveal-delay: {{ (loop.index0 % 8) * 60 }}ms">
        <a href="{{ tile.url if tile.external else (tile.url | lurl(L)) }}" class="hm-action-tile group" {% if tile.external %}target="_blank" rel="noopener"{% endif %}>
          <span class="hm-action-blob" aria-hidden="true"></span>
          <span class="hm-action-icon">{% icon tile.icon or "arrow-right", "size-7 lg:size-8" %}</span>
          <span class="hm-action-title">{{ tile | loc("title", L) }}</span>
          {%- set b = tile | loc("body", L) %}
          {%- if b %}<span class="hm-action-body">{{ b }}</span>{% endif %}
          <span class="hm-action-go" aria-hidden="true">{% icon "arrow-right", "size-4" %}</span>
        </a>
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>
{%- endif %}
