{#-
  Announcements (data/announcements.csv). Only live ones are built; each one also removes itself
  in the visitor's browser once its end date is over (data-hide-after), and the whole strip
  hides itself when nothing is left. The end date is an editing setting, so it is not shown.
-#}
{%- set L = lang -%}
{%- set items = announcements or [] -%}
{%- if items.length %}
<section class="home-ann relative py-10 lg:py-14" aria-labelledby="home-ann-title">
  <div class="bg-confetti pointer-events-none absolute inset-0 -z-10 opacity-60" aria-hidden="true"></div>
  <div class="wrap">
    <div class="mb-5 flex items-center justify-between gap-4 lg:mb-6">
      <h2 id="home-ann-title" class="flex items-center gap-3 font-display text-xl font-bold text-ink-950 sm:text-2xl" style="{{ 'coral' | accent }}">
        <span class="icon-tile size-10 rounded-xl">{% icon "megaphone", "size-5" %}</span>{{ "home.ann.title" | t(L) }}
      </h2>
      <p class="hidden text-sm text-ink-500 sm:block">{{ "home.ann.hint" | t(L) }}</p>
    </div>
    <ul class="home-rail hm-ann-list" role="list" data-limit="8">
      {%- for a in items %}
      {%- set link = a.url if a.external else (a.url | lurl(L)) %}
      <li class="hm-ann-item reveal" {% if a.hideAfter %}data-hide-after="{{ a.hideAfter }}"{% endif %} style="{{ a.color | accent(loop.index0) }}; --reveal-delay: {{ loop.index0 * 70 }}ms">
        <article class="hm-ann-card {{ 'is-pinned' if a.pin }}">
          <div class="flex items-start gap-4">
            <span class="icon-tile shrink-0">{% icon a.icon or "megaphone", "size-6" %}</span>
            <div class="min-w-0 flex-1">
              {%- if a.pin %}
              <p class="mb-1.5 flex flex-wrap items-center gap-2 text-xs font-semibold text-(--a-700)">
                <span class="chip chip-accent">{% icon "pin", "size-3" %}{{ "home.ann.pinned" | t(L) }}</span>
              </p>
              {%- endif %}
              <h3 class="font-display text-lg leading-snug font-bold text-ink-950 text-balance">{{ a | loc("title", L) }}</h3>
            </div>
          </div>
          {%- set body = a | loc("body", L) %}
          {%- if body %}<p class="mt-3 text-[15px] leading-relaxed text-ink-600">{{ body | mdi | safe }}</p>{% endif %}
          {%- if a.url %}
          <a href="{{ link }}" class="hm-ann-link" {% if a.external %}target="_blank" rel="noopener"{% endif %}>
            {{ (a | loc("link_label", L)) or ("ui.read_more" | t(L)) }}
            {%- if a.external %}{% icon "external-link", "size-4" %}{% else %}{% icon "arrow-right", "size-4" %}{% endif %}
            <span class="absolute inset-0" aria-hidden="true"></span>
          </a>
          {%- endif %}
        </article>
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>
{%- endif %}
