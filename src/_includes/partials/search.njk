{#- Site-wide search (Pagefind). Opened by the header button, the mobile menu, the "/" key, the 404 page's two
    buttons (that page is in both languages; each button asks for its own), or an address with ?q=… / ?s=… (app.js).
    data-words-<lang>: the box's wording and the names of the kinds of page, in each language the page can search. -#}
{%- set L = lang -%}
{%- set wordLangs = [{ code: "en" }, { code: "es" }] if page.url == "/404.html" else [L] -%}
<div x-data="searchModal" x-cloak x-show="open" @open-search.window="show($event)" @keydown.window.slash="if (!['INPUT','TEXTAREA','SELECT'].includes($event.target.tagName)) { $event.preventDefault(); show() }"
     {%- for W in wordLangs %}
     data-words-{{ W.code }}="{{ {
       title: 'search.title' | t(W), unavailable: 'search.unavailable' | t(W),
       placeholder: 'search.placeholder' | t(W), zero_results: 'search.zero_results' | t(W), many_results: 'search.many_results' | t(W),
       one_result: 'search.one_result' | t(W), load_more: 'search.load_more' | t(W), meta_type: 'search.meta_type' | t(W),
       types: { home: 'search.type.home' | t(W), event: 'search.type.event' | t(W), district: 'search.type.district' | t(W),
         committee: 'search.type.committee' | t(W), document: 'search.type.document' | t(W), post: 'search.type.post' | t(W),
         service: 'search.type.service' | t(W), page: 'search.type.page' | t(W) }
     } | dump }}"
     {%- endfor %}
     class="fixed inset-0 z-[70]" role="dialog" aria-modal="true" aria-label="{{ 'nav.search' | t(L) }}">
  <div x-show="open" x-transition.opacity class="absolute inset-0 bg-ink-950/60 backdrop-blur-sm" @click="hide()"></div>
  <div x-show="open" x-trap.noscroll="open" @keydown.escape="hide()" x-ref="panel"
       x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0 -translate-y-4 scale-95" x-transition:enter-end="opacity-100 translate-y-0 scale-100"
       class="relative mx-auto mt-[8vh] flex max-h-[84vh] w-[min(56rem,calc(100%-2rem))] flex-col overflow-hidden rounded-3xl bg-white shadow-2xl">
    <div class="flex items-center justify-between gap-4 bg-ring-strong px-6 py-4 text-white">
      <h2 class="flex items-center gap-2 font-display text-lg font-bold">{% icon "search", "size-5" %}<span x-ref="title">{{ "search.title" | t(L) }}</span></h2>
      <button type="button" @click="hide()" class="grid size-11 place-items-center rounded-full bg-white/15 ring-1 ring-white/30 lg:size-9" aria-label="{{ 'nav.close' | t(L) }}">{% icon "x", "size-5" %}</button>
    </div>
    <div class="flex-1 overflow-y-auto p-5 sm:p-6">
      <div id="site-search" x-ref="mount" @click="picked($event)"></div>
      {#- Pagefind's own "N results for …" line is not announced: app.js copies it here once it settles. #}
      <p x-ref="live" class="sr-only" role="status" aria-live="polite"></p>
      <p x-show="failed" x-ref="failed" class="rounded-2xl bg-sun-50 p-4 text-sm text-ink-700">{{ "search.unavailable" | t(L) }}</p>
    </div>
  </div>
</div>
